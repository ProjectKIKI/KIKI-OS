{
  "recipes": [
    {
      "name": "gsettings-desktop-schemas",
      "version": "50.1",
      "release": "2",
      "summary": "GNOME desktop settings schemas and GDesktopEnums introspection data",
      "license": "LGPL-2.1-or-later",
      "tier": "desktop",
      "architectures": [
        "x86_64"
      ],
      "source": {
        "type": "url",
        "url": "https://download.gnome.org/sources/gsettings-desktop-schemas/50/gsettings-desktop-schemas-50.1.tar.xz",
        "file": "gsettings-desktop-schemas-50.1.tar.xz",
        "sha256": "0a2aa25082672585d16fcdab61c7b0e33f035fb87476505c794f29565afa485b"
      },
      "dependencies": {
        "build": [
          "glib",
          "gobject-introspection",
          "linux-headers"
        ],
        "runtime": [
          "glib",
          "gobject-introspection"
        ]
      },
      "build": {
        "system": "meson",
        "sysroot_exclude": [],
        "configure_options": [
          "-Dintrospection=true"
        ],
        "inputs": [
          "distro/specs/graphics-cross.ini",
          "distro/scripts/ki2-target-pkg-config",
          "distro/scripts/ki2-target-run",
          "distro/scripts/ki2-target-python3",
          "distro/scripts/ki2-target-g-ir-scanner",
          "distro/scripts/ki2-target-g-ir-compiler"
        ],
        "configure": [
          "install -Dm755 \"${KI2_REPO_ROOT}/distro/scripts/ki2-target-python3\" \"${KI2_BUILD_DIR}/target-python3\"",
          "install -Dm755 \"${KI2_REPO_ROOT}/distro/scripts/ki2-target-g-ir-scanner\" \"${KI2_BUILD_DIR}/tools/g-ir-scanner\"",
          "sed -i \"1c #!/usr/bin/env ${KI2_BUILD_DIR}/target-python3\" \"${KI2_SYSROOT}/usr/bin/g-ir-scanner\"",
          "install -m755 \"${KI2_SYSROOT}/usr/bin/g-ir-compiler\" \"${KI2_BUILD_DIR}/g-ir-compiler.real\"",
          "install -m755 \"${KI2_REPO_ROOT}/distro/scripts/ki2-target-g-ir-compiler\" \"${KI2_SYSROOT}/usr/bin/g-ir-compiler\"",
          "install -Dm755 \"${KI2_REPO_ROOT}/distro/scripts/ki2-target-pkg-config\" \"${KI2_BUILD_DIR}/target-pkg-config\"",
          "install -m644 \"${KI2_REPO_ROOT}/distro/specs/graphics-cross.ini\" \"${KI2_BUILD_DIR}/cross.ini\"",
          "sed -i -e \"s|@BUILD@|${KI2_BUILD_DIR}|g\" -e \"s|@REPO@|${KI2_REPO_ROOT}|g\" \"${KI2_BUILD_DIR}/cross.ini\"",
          "PATH=\"${KI2_BUILD_DIR}/tools:$PATH\" meson setup \"${KI2_BUILD_DIR}/schemas\" \"${KI2_SOURCE_DIR}\" --cross-file \"${KI2_BUILD_DIR}/cross.ini\" --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nofallback -Dintrospection=true"
        ],
        "compile": [
          "meson compile -C \"${KI2_BUILD_DIR}/schemas\" -j \"${KI2_JOBS}\"",
          "meson test -C \"${KI2_BUILD_DIR}/schemas\" --print-errorlogs --no-rebuild"
        ],
        "install": [
          "DESTDIR=\"${KI2_DESTDIR}\" meson install -C \"${KI2_BUILD_DIR}/schemas\""
        ],
        "env": {
          "KI2_USE_TARGET_LOADER": "1",
          "GI_CROSS_LAUNCHER": "/bin/sh ${KI2_REPO_ROOT}/distro/scripts/ki2-target-run",
          "KI2_SYSROOT_LIBRARY_PATH": "${KI2_BUILD_DIR}/schemas/:${KI2_SYSROOT_LIBRARY_PATH}",
          "CFLAGS": "--sysroot=${KI2_SYSROOT} ${KI2_SYSROOT_CPPFLAGS} -O2 -pipe -fstack-protector-strong -D_FORTIFY_SOURCE=2",
          "LDFLAGS": "--sysroot=${KI2_SYSROOT} -B${KI2_SYSROOT}/usr/lib64/ -B${KI2_SYSROOT}/lib64/ ${KI2_SYSROOT_LDFLAGS} -Wl,-z,relro,-z,now"
        }
      }
    }
  ]
}
