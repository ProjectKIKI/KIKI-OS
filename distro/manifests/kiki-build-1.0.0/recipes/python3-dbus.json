{
  "recipes": [
    {
      "name": "python3-dbus",
      "version": "1.4.0",
      "release": "4",
      "summary": "Python 3 bindings for the D-Bus message bus",
      "license": "MIT",
      "tier": "runtime",
      "architectures": [
        "x86_64"
      ],
      "source": {
        "type": "url",
        "url": "https://dbus.freedesktop.org/releases/dbus-python/dbus-python-1.4.0.tar.xz",
        "file": "dbus-python-1.4.0.tar.xz",
        "sha256": "c36b28f10ffcc8f1f798aca973bcc132f91f33eb9b6b8904381b4077766043d5"
      },
      "dependencies": {
        "build": [
          "dbus",
          "glib",
          "python"
        ],
        "runtime": [
          "dbus",
          "glib",
          "glibc",
          "python"
        ]
      },
      "build": {
        "system": "meson",
        "sysroot_exclude": [
          "glibc"
        ],
        "configure_options": [
          "-Dbuildtype=release",
          "-Ddoc=disabled",
          "-Dinstalled_tests=false",
          "-Dtests=disabled",
          "-Dpython.platlibdir=lib/python3.12/site-packages",
          "-Dpython.purelibdir=lib/python3.12/site-packages"
        ],
        "configure": [
          "install -Dm755 \"${KI2_REPO_ROOT}/distro/scripts/ki2-target-python3\" \"${KI2_BUILD_DIR}/target-python3\"",
          "meson setup \"${KI2_BUILD_DIR}/python3-dbus\" \"${KI2_SOURCE_DIR}\" --prefix=/usr --libdir=lib -Dbuildtype=release -Ddoc=disabled -Dinstalled_tests=false -Dtests=disabled -Dpython=\"${KI2_BUILD_DIR}/target-python3\" -Dpython.platlibdir=lib/python3.12/site-packages -Dpython.purelibdir=lib/python3.12/site-packages"
        ],
        "compile": [
          "meson compile -C \"${KI2_BUILD_DIR}/python3-dbus\" -j \"${KI2_JOBS}\""
        ],
        "install": [
          "DESTDIR=\"${KI2_DESTDIR}\" meson install -C \"${KI2_BUILD_DIR}/python3-dbus\"",
          "find \"${KI2_DESTDIR}/usr/lib/python3.12\" -type f -name '*.pyc' -delete",
          "find \"${KI2_DESTDIR}/usr/lib/python3.12\" -depth -type d -name '__pycache__' -empty -delete",
          "find \"${KI2_DESTDIR}/usr/lib/python3.12\" -type f -exec sh -c 'for binary do file \"${binary}\" | grep -q ELF && strip --strip-unneeded \"${binary}\" || true; done' sh '{}' +"
        ],
        "env": {
          "CPPFLAGS": "${KI2_SYSROOT_CPPFLAGS}",
          "CFLAGS": "${KI2_SYSROOT_CPPFLAGS} -O2 -pipe -fstack-protector-strong -D_FORTIFY_SOURCE=2 -ffile-prefix-map=${KI2_WORK}=/usr/src/python3-dbus -fdebug-prefix-map=${KI2_WORK}=/usr/src/python3-dbus -ffile-prefix-map=${KI2_SYSROOT}=/usr -fdebug-prefix-map=${KI2_SYSROOT}=/usr",
          "LDFLAGS": "${KI2_SYSROOT_LDFLAGS} -Wl,-z,relro,-z,now",
          "PYTHONDONTWRITEBYTECODE": "1",
          "PYTHONHASHSEED": "0"
        }
      }
    }
  ]
}
