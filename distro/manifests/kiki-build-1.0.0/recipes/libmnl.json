{
  "recipes": [
    {
      "name": "libmnl",
      "version": "1.0.5",
      "release": "1",
      "summary": "Minimalistic Netlink userspace library",
      "license": "LGPL-2.1-or-later",
      "tier": "network",
      "architectures": [
        "x86_64"
      ],
      "source": {
        "type": "url",
        "url": "https://www.netfilter.org/projects/libmnl/files/libmnl-1.0.5.tar.bz2",
        "file": "libmnl-1.0.5.tar.bz2",
        "sha256": "274b9b919ef3152bfb3da3a13c950dd60d6e2bcd54230ffeca298d03b40d0525"
      },
      "dependencies": {
        "build": [],
        "runtime": [
          "glibc"
        ]
      },
      "build": {
        "system": "gnu",
        "sysroot_exclude": [
          "glibc"
        ],
        "configure": [
          "cd \"${KI2_SOURCE_DIR}\" && ./configure --prefix=/usr"
        ],
        "compile": [
          "make -C \"${KI2_SOURCE_DIR}\" -j\"${KI2_JOBS}\""
        ],
        "install": [
          "make -C \"${KI2_SOURCE_DIR}\" DESTDIR=\"${KI2_DESTDIR}\" install",
          "find \"${KI2_DESTDIR}/usr/lib\" -name '*.la' -delete"
        ],
        "env": {
          "CFLAGS": "-O2 -pipe -fstack-protector-strong -D_FORTIFY_SOURCE=2",
          "LDFLAGS": "-Wl,-z,relro,-z,now"
        }
      }
    }
  ]
}
