{
  "recipes": [
    {
      "name": "libpng",
      "version": "1.6.58",
      "release": "1",
      "summary": "PNG reference image decoding and encoding library",
      "license": "libpng-2.0",
      "tier": "library",
      "architectures": [
        "x86_64"
      ],
      "source": {
        "type": "url",
        "url": "https://download.sourceforge.net/libpng/libpng-1.6.58.tar.xz",
        "file": "libpng-1.6.58.tar.xz",
        "sha256": "28eb403f51f0f7405249132cecfe82ea5c0ef97f1b32c5a65828814ae0d34775"
      },
      "dependencies": {
        "build": [
          "linux-headers"
        ],
        "runtime": [
          "glibc",
          "zlib"
        ]
      },
      "build": {
        "system": "gnu",
        "configure": [
          "cd \"${KI2_SOURCE_DIR}\" && ./configure --prefix=/usr --libdir=/usr/lib --build=x86_64-pc-linux-gnu --host=${KI2_TARGET_TRIPLE} --enable-shared --disable-static",
          "sed -i -e \"s/^hardcode_libdir_flag_spec=.*/hardcode_libdir_flag_spec=/\" -e \"s/^runpath_var=.*/runpath_var=/\" \"${KI2_SOURCE_DIR}/libtool\""
        ],
        "compile": [
          "make -C \"${KI2_SOURCE_DIR}\" -j \"${KI2_JOBS}\""
        ],
        "install": [
          "make -C \"${KI2_SOURCE_DIR}\" DESTDIR=\"${KI2_DESTDIR}\" install",
          "rm -f \"${KI2_DESTDIR}/usr/lib/libpng16.la\" \"${KI2_DESTDIR}/usr/lib/libpng.la\"",
          "install -Dm644 \"${KI2_SOURCE_DIR}/LICENSE\" \"${KI2_DESTDIR}/usr/share/licenses/libpng/LICENSE\"",
          "readelf -d \"${KI2_DESTDIR}/usr/lib/libpng16.so.16\" > \"${KI2_BUILD_DIR}/elf-dynamic.txt\" && ! grep -E \"RPATH|RUNPATH\" \"${KI2_BUILD_DIR}/elf-dynamic.txt\""
        ],
        "env": {
          "CC": "cc --sysroot=${KI2_SYSROOT}",
          "CFLAGS": "--sysroot=${KI2_SYSROOT} ${KI2_SYSROOT_CPPFLAGS} -O2 -pipe -fstack-protector-strong -D_FORTIFY_SOURCE=2",
          "LDFLAGS": "--sysroot=${KI2_SYSROOT} -B${KI2_SYSROOT}/usr/lib64/ -B${KI2_SYSROOT}/lib64/ ${KI2_SYSROOT_LDFLAGS} -Wl,-z,relro,-z,now"
        }
      }
    }
  ]
}
