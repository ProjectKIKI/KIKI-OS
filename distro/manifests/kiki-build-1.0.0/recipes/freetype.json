{
  "recipes": [
    {
      "name": "freetype",
      "version": "2.14.3",
      "release": "1",
      "summary": "Native font rasterizer (desktop bootstrap; compression extensions pending)",
      "license": "FTL OR GPL-2.0-or-later",
      "tier": "library",
      "architectures": [
        "x86_64"
      ],
      "source": {
        "type": "url",
        "url": "https://download.savannah.gnu.org/releases/freetype/freetype-2.14.3.tar.xz",
        "file": "freetype-2.14.3.tar.xz",
        "sha256": "36bc4f1cc413335368ee656c42afca65c5a3987e8768cc28cf11ba775e785a5f"
      },
      "dependencies": {
        "build": [
          "linux-headers"
        ],
        "runtime": [
          "glibc",
          "zlib",
          "libpng"
        ]
      },
      "build": {
        "system": "meson",
        "inputs": [
          "distro/specs/graphics-cross.ini",
          "distro/scripts/ki2-target-pkg-config",
          "distro/scripts/ki2-target-run"
        ],
        "configure": [
          "install -Dm755 \"${KI2_REPO_ROOT}/distro/scripts/ki2-target-pkg-config\" \"${KI2_BUILD_DIR}/target-pkg-config\"",
          "install -m644 \"${KI2_REPO_ROOT}/distro/specs/graphics-cross.ini\" \"${KI2_BUILD_DIR}/cross.ini\"",
          "sed -i -e \"s|@BUILD@|${KI2_BUILD_DIR}|g\" -e \"s|@REPO@|${KI2_REPO_ROOT}|g\" \"${KI2_BUILD_DIR}/cross.ini\"",
          "meson setup \"${KI2_BUILD_DIR}/freetype\" \"${KI2_SOURCE_DIR}\" --cross-file \"${KI2_BUILD_DIR}/cross.ini\" --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nofallback -Ddefault_library=shared -Dpng=enabled -Dzlib=system -Dharfbuzz=dynamic -Dbrotli=disabled -Dbzip2=disabled -Derror_strings=true"
        ],
        "compile": [
          "meson compile -C \"${KI2_BUILD_DIR}/freetype\" -j \"${KI2_JOBS}\""
        ],
        "install": [
          "DESTDIR=\"${KI2_DESTDIR}\" meson install -C \"${KI2_BUILD_DIR}/freetype\"",
          "install -d \"${KI2_DESTDIR}/usr/share/licenses/freetype\"",
          "install -m644 \"${KI2_SOURCE_DIR}/LICENSE.TXT\" \"${KI2_SOURCE_DIR}/docs/FTL.TXT\" \"${KI2_SOURCE_DIR}/docs/GPLv2.TXT\" \"${KI2_DESTDIR}/usr/share/licenses/freetype/\"",
          "cp -a \"${KI2_SOURCE_DIR}/src\" \"${KI2_DESTDIR}/usr/share/licenses/freetype/source-notices\"",
          "readelf -d \"${KI2_DESTDIR}/usr/lib/libfreetype.so.6\" > \"${KI2_BUILD_DIR}/elf-dynamic.txt\" && ! grep -E \"RPATH|RUNPATH\" \"${KI2_BUILD_DIR}/elf-dynamic.txt\""
        ],
        "env": {
          "CFLAGS": "--sysroot=${KI2_SYSROOT} ${KI2_SYSROOT_CPPFLAGS} -O2 -pipe -fstack-protector-strong -D_FORTIFY_SOURCE=2",
          "LDFLAGS": "--sysroot=${KI2_SYSROOT} -B${KI2_SYSROOT}/usr/lib64/ -B${KI2_SYSROOT}/lib64/ ${KI2_SYSROOT_LDFLAGS} -Wl,-z,relro,-z,now"
        }
      }
    }
  ]
}
