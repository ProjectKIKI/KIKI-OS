{
  "recipes": [
    {
      "name": "gmp",
      "version": "6.3.0",
      "release": "3",
      "summary": "GNU multiple precision arithmetic library",
      "license": "LGPL-3.0-or-later OR GPL-2.0-or-later",
      "tier": "base",
      "architectures": [
        "x86_64"
      ],
      "source": {
        "type": "url",
        "url": "https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz",
        "file": "gmp-6.3.0.tar.xz",
        "sha256": "a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898"
      },
      "dependencies": {
        "build": [
          "linux-headers"
        ],
        "runtime": [
          "glibc"
        ]
      },
      "build": {
        "system": "gnu",
        "configure": [
          "cd \"${KI2_SOURCE_DIR}\" && ./configure --prefix=/usr --libdir=/usr/lib --build=x86_64-pc-linux-gnu --host=${KI2_TARGET_TRIPLE} --disable-static --enable-shared --enable-fat"
        ],
        "compile": [
          "make -C \"${KI2_SOURCE_DIR}\" -j\"${KI2_JOBS}\""
        ],
        "install": [
          "make -C \"${KI2_SOURCE_DIR}\" DESTDIR=\"${KI2_DESTDIR}\" install",
          "rm -f \"${KI2_DESTDIR}/usr/lib/libgmp.la\"",
          "install -d \"${KI2_DESTDIR}/usr/share/licenses/gmp\"",
          "install -m 0644 \"${KI2_SOURCE_DIR}/COPYING\" \"${KI2_SOURCE_DIR}/COPYING.LESSERv3\" \"${KI2_SOURCE_DIR}/COPYINGv2\" \"${KI2_DESTDIR}/usr/share/licenses/gmp/\"",
          "readelf -d \"${KI2_DESTDIR}/usr/lib/libgmp.so.10\" > \"${KI2_BUILD_DIR}/elf-dynamic.txt\" && ! grep -E \"RPATH|RUNPATH\" \"${KI2_BUILD_DIR}/elf-dynamic.txt\""
        ],
        "env": {
          "CC": "cc --sysroot=${KI2_SYSROOT}",
          "CFLAGS": "--sysroot=${KI2_SYSROOT} ${KI2_SYSROOT_CPPFLAGS} -O2 -pipe -fstack-protector-strong -D_FORTIFY_SOURCE=2",
          "LDFLAGS": "--sysroot=${KI2_SYSROOT} -B${KI2_SYSROOT}/usr/lib64/ -B${KI2_SYSROOT}/lib64/ ${KI2_SYSROOT_LDFLAGS} -Wl,-z,relro,-z,now"
        }
      }
    }
  ]
}
