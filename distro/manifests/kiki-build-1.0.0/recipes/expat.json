{
  "recipes": [
    {
      "name": "expat",
      "version": "2.6.2",
      "release": "3",
      "summary": "XML parser required by D-Bus",
      "license": "MIT",
      "tier": "base",
      "architectures": [
        "x86_64"
      ],
      "source": {
        "type": "url",
        "url": "https://github.com/libexpat/libexpat/releases/download/R_2_6_2/expat-2.6.2.tar.xz",
        "sha256": "ee14b4c5d8908b1bec37ad937607eab183d4d9806a08adee472c3c3121d27364"
      },
      "dependencies": {
        "build": [],
        "runtime": [
          "glibc"
        ]
      },
      "build": {
        "system": "gnu",
        "sysroot_exclude": [
          "glibc"
        ],
        "configure_options": [
          "--disable-static"
        ],
        "configure": [
          "cd ${KI2_SOURCE_DIR} && ./configure --prefix=/usr --disable-static"
        ],
        "compile": [
          "make -C ${KI2_SOURCE_DIR} -j${KI2_JOBS}"
        ],
        "install": [
          "make -C ${KI2_SOURCE_DIR} DESTDIR=${KI2_DESTDIR} install",
          "find ${KI2_DESTDIR}/usr/lib -name '*.la' -delete",
          "find ${KI2_DESTDIR}/usr/lib -name '*.a' -delete",
          "find ${KI2_DESTDIR}/usr/bin ${KI2_DESTDIR}/usr/lib -type f -exec sh -c 'for binary do file \"${binary}\" | grep -q ELF && strip --strip-unneeded \"${binary}\" || true; done' sh {} +"
        ]
      }
    }
  ]
}
