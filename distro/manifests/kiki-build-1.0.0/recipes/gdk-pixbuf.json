{
  "recipes": [
    {
      "name": "gdk-pixbuf",
      "version": "2.44.7",
      "release": "2",
      "summary": "Native GNOME 50 desktop dependency",
      "license": "LGPL-2.1-or-later",
      "tier": "desktop",
      "architectures": [
        "x86_64"
      ],
      "source": {
        "type": "url",
        "url": "https://download.gnome.org/sources/gdk-pixbuf/2.44/gdk-pixbuf-2.44.7.tar.xz",
        "sha256": "172f80e3626ec31520a970400f1a3694e04718f6c2cd2885f75250fb5a6995a4"
      },
      "dependencies": {
        "build": [
          "linux-headers",
          "gobject-introspection"
        ],
        "runtime": [
          "glib",
          "glibc",
          "libjpeg-turbo",
          "libpng",
          "shared-mime-info"
        ]
      },
      "build": {
        "system": "meson",
        "configure_options": [
          "-Ddocumentation=false",
          "-Dman=false",
          "-Dintrospection=enabled",
          "-Dtests=false",
          "-Dinstalled_tests=false",
          "-Dthumbnailer=disabled",
          "-Dglycin=disabled",
          "-Dpng=enabled",
          "-Djpeg=enabled",
          "-Dtiff=disabled",
          "-Dgif=enabled",
          "-Dbuiltin_loaders=png,jpeg,gif,bmp,ico"
        ]
      }
    }
  ]
}
