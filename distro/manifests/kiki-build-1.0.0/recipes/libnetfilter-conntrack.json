{
  "recipes": [
    {
      "name": "libnetfilter-conntrack",
      "version": "1.1.1",
      "release": "2",
      "summary": "Netfilter connection tracking userspace library",
      "license": "GPL-2.0-or-later",
      "tier": "network",
      "architectures": [
        "x86_64"
      ],
      "source": {
        "type": "url",
        "url": "https://www.netfilter.org/projects/libnetfilter_conntrack/files/libnetfilter_conntrack-1.1.1.tar.xz",
        "file": "libnetfilter_conntrack-1.1.1.tar.xz",
        "sha256": "769d3eaf57fa4fbdb05dd12873b6cb9a5be7844d8937e222b647381d44284820"
      },
      "dependencies": {
        "build": [
          "libmnl",
          "libnfnetlink"
        ],
        "runtime": [
          "glibc",
          "libmnl",
          "libnfnetlink"
        ]
      },
      "build": {
        "system": "gnu",
        "sysroot_exclude": [
          "glibc"
        ],
        "configure": [
          "cd \"${KI2_SOURCE_DIR}\" && ./configure --prefix=/usr"
        ],
        "compile": [
          "make -C \"${KI2_SOURCE_DIR}\" -j\"${KI2_JOBS}\""
        ],
        "install": [
          "make -C \"${KI2_SOURCE_DIR}\" DESTDIR=\"${KI2_DESTDIR}\" install",
          "find \"${KI2_DESTDIR}/usr/lib\" -name '*.la' -delete",
          "sed -i \"s#-L${KI2_SYSROOT}/usr/lib ##g\" \"${KI2_DESTDIR}/usr/lib/pkgconfig/libnetfilter_conntrack.pc\""
        ],
        "env": {
          "CPPFLAGS": "${KI2_SYSROOT_CPPFLAGS}",
          "CFLAGS": "-O2 -pipe -fstack-protector-strong -D_FORTIFY_SOURCE=2",
          "LDFLAGS": "${KI2_SYSROOT_LDFLAGS} -Wl,-z,relro,-z,now"
        }
      }
    }
  ]
}
