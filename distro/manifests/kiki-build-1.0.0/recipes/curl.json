{
  "recipes": [
    {
      "name": "curl",
      "version": "8.8.0",
      "release": "4",
      "summary": "URL transfer utility",
      "license": "curl",
      "tier": "network",
      "architectures": [
        "x86_64"
      ],
      "source": {
        "type": "url",
        "url": "https://curl.se/download/curl-8.8.0.tar.xz",
        "sha256": "0f58bb95fc330c8a46eeb3df5701b0d90c9d9bfcc42bd1cd08791d12551d4400"
      },
      "dependencies": {
        "build": [],
        "runtime": [
          "glibc",
          "openssl",
          "zlib",
          "zstd",
          "ca-certificates"
        ]
      },
      "build": {
        "system": "gnu",
        "configure": [
          "sed -i \"s/@LDFLAGS@ //g\" \"${KI2_SOURCE_DIR}/curl-config.in\"",
          "cd \"${KI2_SOURCE_DIR}\" && ./configure --prefix=/usr --build=x86_64-pc-linux-gnu --host=${KI2_TARGET_TRIPLE} --with-openssl --with-zstd --with-ca-bundle=/etc/ssl/certs/ca-certificates.crt --without-ca-path --disable-ldap --disable-ldaps"
        ],
        "compile": [
          "make -C \"${KI2_SOURCE_DIR}\" -j \"${KI2_JOBS}\""
        ],
        "install": [
          "make -C \"${KI2_SOURCE_DIR}\" DESTDIR=\"${KI2_DESTDIR}\" install",
          "rm -f \"${KI2_DESTDIR}/usr/lib/libcurl.la\"",
          "readelf -d \"${KI2_DESTDIR}/usr/lib/libcurl.so.4\" \"${KI2_DESTDIR}/usr/bin/curl\" > \"${KI2_BUILD_DIR}/elf-dynamic.txt\" && ! grep -E \"RPATH|RUNPATH\" \"${KI2_BUILD_DIR}/elf-dynamic.txt\""
        ],
        "env": {
          "CC": "cc",
          "CFLAGS": "--sysroot=${KI2_SYSROOT} ${KI2_SYSROOT_CPPFLAGS} -O2 -pipe -fstack-protector-strong -D_FORTIFY_SOURCE=2",
          "LDFLAGS": "--sysroot=${KI2_SYSROOT} -B${KI2_SYSROOT}/usr/lib64/ -B${KI2_SYSROOT}/lib64/ ${KI2_SYSROOT_LDFLAGS} -Wl,-z,relro,-z,now"
        }
      }
    }
  ]
}
