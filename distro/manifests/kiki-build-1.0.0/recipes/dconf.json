{
  "recipes": [
    {
      "name": "dconf",
      "version": "0.49.0",
      "release": "2",
      "summary": "GNOME settings database, GSettings backend and user-session service",
      "license": "LGPL-2.1-or-later",
      "tier": "desktop",
      "architectures": [
        "x86_64"
      ],
      "source": {
        "type": "url",
        "url": "https://download.gnome.org/sources/dconf/0.49/dconf-0.49.0.tar.xz",
        "file": "dconf-0.49.0.tar.xz",
        "sha256": "16a47e49a58156dbb96578e1708325299e4c19eea9be128d5bd12fd0963d6c36"
      },
      "dependencies": {
        "build": [
          "glib",
          "dbus"
        ],
        "runtime": [
          "dbus",
          "glib",
          "glibc"
        ]
      },
      "build": {
        "system": "meson",
        "sysroot_exclude": [
          "glibc"
        ],
        "configure_options": [
          "--sysconfdir=/etc",
          "--libexecdir=libexec",
          "-Ddefault_library=shared",
          "-Dman=false",
          "-Dgtk_doc=false",
          "-Dvapi=false",
          "-Dbash_completion=false",
          "-Dsystemduserunitdir=/usr/lib/systemd/user"
        ],
        "env": {
          "CFLAGS": "${KI2_SYSROOT_CPPFLAGS} -O2 -pipe -fstack-protector-strong -D_FORTIFY_SOURCE=2",
          "LDFLAGS": "${KI2_SYSROOT_LDFLAGS} -Wl,-z,relro,-z,now"
        }
      }
    }
  ]
}
