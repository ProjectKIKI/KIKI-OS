{
  "recipes": [
    {
      "name": "nspr",
      "version": "4.36",
      "release": "1",
      "summary": "Native Mozilla support library for GNOME",
      "license": "MPL-2.0",
      "tier": "library",
      "architectures": [
        "x86_64"
      ],
      "source": {
        "type": "url",
        "url": "https://archive.mozilla.org/pub/firefox/releases/140.1.0esr/source/firefox-140.1.0esr.source.tar.xz",
        "sha256": "d15c65d790e0c371b5c95332141b1bdeb29fefc27f852d22a5f542b6d1bc1922"
      },
      "dependencies": {
        "build": [
          "linux-headers"
        ],
        "runtime": [
          "glibc"
        ]
      },
      "build": {
        "system": "gnu",
        "configure_options": [
          "--prefix=/usr",
          "--libdir=/usr/lib",
          "--includedir=/usr/include/nspr",
          "--build=x86_64-pc-linux-gnu",
          "--host=x86_64-kiki-linux-gnu",
          "--enable-64bit",
          "--disable-debug",
          "--enable-optimize"
        ]
      }
    }
  ]
}
