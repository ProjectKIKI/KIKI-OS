        ],
        "runtime": [
          "glibc",
          "libidn2",
          "libunistring"
        ]
      },
      "build": {
        "system": "gnu",
        "configure_options": [
          "--prefix=/usr",
          "--libdir=/usr/lib",
          "--build=x86_64-pc-linux-gnu",
          "--host=x86_64-kiki-linux-gnu",
          "--disable-static",
          "--disable-gtk-doc",
          "--disable-man"
