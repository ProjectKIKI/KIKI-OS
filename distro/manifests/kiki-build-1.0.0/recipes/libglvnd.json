        "sha256": "2b6e15b06aafb4c0b6e2348124808cbd9b291c647299eaaba2e3202f51ff2f3d"
      },
      "dependencies": {
        "build": [
          "linux-headers",
          "gobject-introspection"
        ],
        "runtime": [
          "glibc"
        ]
      },
      "build": {
        "system": "meson",
        "configure_options": [
          "-Dx11=disabled",
          "-Dglx=disabled",
          "-Degl=true",
          "-Dgles1=true",
          "-Dgles2=true",
          "-Dheaders=true"
