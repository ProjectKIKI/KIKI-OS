          "at-spi2-core",
          "cairo",
          "fontconfig",
          "fribidi",
          "gdk-pixbuf",
          "glib",
          "glibc",
          "glycin",
          "graphene",
          "harfbuzz",
          "hicolor-icon-theme",
          "kiki-desktop-fonts",
          "libepoxy",
          "libjpeg-turbo",
          "libpng",
          "libtiff",
          "libxkbcommon",
          "pango",
          "wayland"
        ]
      },
      "build": {
        "system": "meson",
        "configure_options": [
          "-Dx11-backend=false",
          "-Dwayland-backend=true",
          "-Dbroadway-backend=false",
          "-Dvulkan=disabled",
          "-Dmedia-gstreamer=disabled",
          "-Dprint-cups=disabled",
          "-Ddocumentation=false",
          "-Dman-pages=false",
          "-Dbuild-demos=false",
          "-Dbuild-examples=false",
          "-Dbuild-tests=false",
          "-Dbuild-testsuite=false",
          "-Dintrospection=enabled"
