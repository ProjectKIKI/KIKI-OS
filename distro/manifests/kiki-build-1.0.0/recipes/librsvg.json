{
  "recipes": [
    {
      "name": "librsvg",
      "version": "2.62.3",
      "release": "3",
      "summary": "Native GNOME 50 desktop dependency",
      "license": "LGPL-2.1-or-later",
      "tier": "desktop",
      "architectures": [
        "x86_64"
      ],
      "source": {
        "type": "url",
        "url": "https://download.gnome.org/sources/librsvg/2.62/librsvg-2.62.3.tar.xz",
        "sha256": "7eb449b2722a768021356f66dfee3202c229b54ed4e6a70ce40c090e97ff16f2"
      },
      "dependencies": {
        "build": [
          "linux-headers",
          "gobject-introspection"
        ],
        "runtime": [
          "cairo",
          "gdk-pixbuf",
          "glib",
          "glibc",
          "libgcc",
          "libxml2",
          "pango"
        ]
      },
      "build": {
        "system": "meson",
        "configure_options": [
          "-Ddocs=disabled",
          "-Dintrospection=enabled",
          "-Dpixbuf=enabled",
          "-Dpixbuf-loader=enabled",
          "-Drsvg-convert=disabled",
          "-Dvala=disabled",
          "-Dtests=false",
          "-Davif=disabled",
          "-Dtriplet=x86_64-unknown-linux-gnu"
        ]
      }
    }
  ]
}
