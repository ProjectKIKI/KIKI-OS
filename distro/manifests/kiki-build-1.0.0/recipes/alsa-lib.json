{
  "recipes": [
    {
      "name": "alsa-lib",
      "version": "1.2.14",
      "release": "1",
      "summary": "Native GNOME desktop dependency",
      "license": "LGPL-2.1-or-later",
      "tier": "library",
      "architectures": [
        "x86_64"
      ],
      "source": {
        "type": "url",
        "url": "https://www.alsa-project.org/files/pub/lib/alsa-lib-1.2.14.tar.bz2",
        "sha256": "be9c88a0b3604367dd74167a2b754a35e142f670292ae47a2fdef27a2ee97a32"
      },
      "dependencies": {
        "build": [
          "linux-headers"
        ],
        "runtime": [
          "glibc"
        ]
      },
      "build": {
        "system": "gnu",
        "configure_options": [
          "--prefix=/usr",
          "--libdir=/usr/lib",
          "--build=x86_64-pc-linux-gnu",
          "--host=x86_64-kiki-linux-gnu",
          "--disable-static",
          "--disable-python"
        ]
