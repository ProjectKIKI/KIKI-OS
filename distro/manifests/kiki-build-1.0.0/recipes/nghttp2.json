{
  "recipes": [
    {
      "name": "nghttp2",
      "version": "1.64.0",
      "release": "1",
      "summary": "Native GNOME desktop dependency",
      "license": "MIT",
      "tier": "library",
      "architectures": [
        "x86_64"
      ],
      "source": {
        "type": "url",
        "url": "https://github.com/nghttp2/nghttp2/releases/download/v1.64.0/nghttp2-1.64.0.tar.xz",
        "sha256": "88bb94c9e4fd1c499967f83dece36a78122af7d5fb40da2019c56b9ccc6eb9dd"
      },
      "dependencies": {
        "build": [
          "linux-headers"
        ],
        "runtime": [
          "glibc"
        ]
      },
      "build": {
        "system": "gnu",
        "configure_options": [
          "--prefix=/usr",
          "--libdir=/usr/lib",
          "--build=x86_64-pc-linux-gnu",
          "--host=x86_64-kiki-linux-gnu",
          "--enable-lib-only",
          "--disable-static",
          "--disable-examples",
          "--disable-app",
          "--disable-hpack-tools"
        ]
      }
    }
  ]
}
