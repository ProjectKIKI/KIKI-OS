{
  "recipes": [
    {
      "name": "polkit",
      "version": "127",
      "release": "4",
      "summary": "System authorization service and authentication agent libraries",
      "license": "LGPL-2.0-or-later",
      "tier": "library",
      "architectures": [
        "x86_64"
      ],
      "source": {
        "type": "url",
        "url": "https://github.com/polkit-org/polkit/archive/refs/tags/127.tar.gz",
        "file": "polkit-127.tar.gz",
        "sha256": "9b7bc16f086479dcc626c575976568ba4a85d34297a750d8ab3d2e57f6d8b988"
      },
      "dependencies": {
        "build": [
          "linux-headers",
          "gobject-introspection"
        ],
        "runtime": [
          "dbus",
          "duktape",
          "expat",
          "glib",
          "glibc",
          "gobject-introspection",
          "libsystemd",
          "linux-pam",
          "systemd"
        ]
      },
      "build": {
        "system": "meson",
        "inputs": [
          "distro/sources/polkit/etc/pam.d/polkit-1",
          "distro/sources/polkit/po/ko.po",
          "distro/scripts/ki2-target-python3",
          "distro/scripts/ki2-target-g-ir-scanner",
          "distro/scripts/ki2-target-g-ir-compiler",
          "distro/scripts/ki2-target-pkg-config",
          "distro/scripts/ki2-target-run",
          "tools/ki2build.py"
        ],
        "configure": [
          "install -m644 \"${KI2_REPO_ROOT}/distro/sources/polkit/po/ko.po\" \"${KI2_SOURCE_DIR}/po/ko.po\"",
          "sed -i '/^ka$/a ko' \"${KI2_SOURCE_DIR}/po/LINGUAS\"",
          "msgfmt --check -o /dev/null \"${KI2_SOURCE_DIR}/po/ko.po\"",
          "sed -i -e \"s|sysusers_dir = systemd_dep.get_variable.*|sysusers_dir = '/usr/lib/sysusers.d'|\" -e \"s|tmpfiles_dir = systemd_dep.get_variable.*|tmpfiles_dir = '/usr/lib/tmpfiles.d'|\" \"${KI2_SOURCE_DIR}/meson.build\"",
          "install -Dm755 \"${KI2_REPO_ROOT}/distro/scripts/ki2-target-python3\" \"${KI2_BUILD_DIR}/target-python3\"",
          "install -Dm755 \"${KI2_REPO_ROOT}/distro/scripts/ki2-target-g-ir-scanner\" \"${KI2_BUILD_DIR}/tools/g-ir-scanner\"",
          "sed -i \"1c #!/usr/bin/env ${KI2_BUILD_DIR}/target-python3\" \"${KI2_SYSROOT}/usr/bin/g-ir-scanner\"",
          "install -m755 \"${KI2_SYSROOT}/usr/bin/g-ir-compiler\" \"${KI2_BUILD_DIR}/g-ir-compiler.real\"",
          "install -m755 \"${KI2_REPO_ROOT}/distro/scripts/ki2-target-g-ir-compiler\" \"${KI2_SYSROOT}/usr/bin/g-ir-compiler\"",
          "install -Dm755 \"${KI2_REPO_ROOT}/distro/scripts/ki2-target-pkg-config\" \"${KI2_BUILD_DIR}/target-pkg-config\"",
          "PATH=\"${KI2_BUILD_DIR}/tools:$PATH\" meson setup \"${KI2_BUILD_DIR}/polkit\" \"${KI2_SOURCE_DIR}\" --prefix=/usr --libdir=lib --sysconfdir=/etc --buildtype=release -Dlibs-only=false -Dauthfw=pam -Dos_type=lfs -Dpam_prefix=/etc/pam.d -Dpam_module_dir=/usr/lib/security -Dsession_tracking=logind -Dsystemdsystemunitdir=/usr/lib/systemd/system -Dprivileged_group=wheel -Dintrospection=true -Dgettext=true -Dtests=true -Dman=false -Dgtk_doc=false"
        ],
        "compile": [
          "meson compile -C \"${KI2_BUILD_DIR}/polkit\" -j \"${KI2_JOBS}\""
        ],
        "install": [
          "DESTDIR=\"${KI2_DESTDIR}\" meson install -C \"${KI2_BUILD_DIR}/polkit\"",
          "test ! -e \"${KI2_DESTDIR}/tmp\" && test -f \"${KI2_DESTDIR}/usr/lib/sysusers.d/polkit.conf\" && test -f \"${KI2_DESTDIR}/usr/lib/tmpfiles.d/polkit-tmpfiles.conf\" && test -f \"${KI2_DESTDIR}/usr/lib/systemd/system/polkit-agent-helper.socket\"",
          "install -Dm644 \"${KI2_REPO_ROOT}/distro/sources/polkit/etc/pam.d/polkit-1\" \"${KI2_DESTDIR}/etc/pam.d/polkit-1\"",
          "chmod 4755 \"${KI2_DESTDIR}/usr/bin/pkexec\" \"${KI2_DESTDIR}/usr/lib/polkit-1/polkit-agent-helper-1\"",
          "install -Dm644 \"${KI2_SOURCE_DIR}/COPYING\" \"${KI2_DESTDIR}/usr/share/licenses/polkit/COPYING\"",
          "readelf -d \"${KI2_DESTDIR}/usr/lib/polkit-1/polkitd\" \"${KI2_DESTDIR}/usr/lib/libpolkit-gobject-1.so.0\" > \"${KI2_BUILD_DIR}/elf-dynamic.txt\" && ! grep -E \"RPATH|RUNPATH\" \"${KI2_BUILD_DIR}/elf-dynamic.txt\""
        ],
        "env": {
          "PKG_CONFIG": "${KI2_BUILD_DIR}/target-pkg-config",
          "CFLAGS": "--sysroot=${KI2_SYSROOT} ${KI2_SYSROOT_CPPFLAGS} -O2 -pipe -fstack-protector-strong -D_FORTIFY_SOURCE=2",
          "LDFLAGS": "--sysroot=${KI2_SYSROOT} -B${KI2_SYSROOT}/usr/lib64/ -B${KI2_SYSROOT}/lib64/ ${KI2_SYSROOT_LDFLAGS} -Wl,-z,relro,-z,now",
          "PYTHONDONTWRITEBYTECODE": "1",
          "PYTHONHASHSEED": "0",
          "KI2_USE_TARGET_LOADER": "1",
          "GI_CROSS_LAUNCHER": "/bin/sh ${KI2_REPO_ROOT}/distro/scripts/ki2-target-run"
        }
      }
    }
  ]
}
