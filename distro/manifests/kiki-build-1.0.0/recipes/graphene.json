{
  "recipes": [
    {
      "name": "graphene",
      "version": "1.10.8",
      "release": "2",
      "summary": "Graphics vector and matrix types with GObject introspection",
      "license": "MIT",
      "tier": "library",
      "architectures": [
        "x86_64"
      ],
      "source": {
        "type": "url",
        "url": "https://download.gnome.org/sources/graphene/1.10/graphene-1.10.8.tar.xz",
        "file": "graphene-1.10.8.tar.xz",
        "sha256": "a37bb0e78a419dcbeaa9c7027bcff52f5ec2367c25ec859da31dfde2928f279a"
      },
      "dependencies": {
        "build": [
          "linux-headers",
          "gobject-introspection"
        ],
        "runtime": [
          "glib",
          "glibc",
          "gobject-introspection"
        ]
      },
      "build": {
        "system": "meson",
        "inputs": [
          "distro/specs/graphics-cross.ini",
          "distro/scripts/ki2-target-pkg-config",
          "distro/scripts/ki2-target-run",
          "distro/scripts/ki2-target-python3",
          "distro/scripts/ki2-target-g-ir-scanner",
          "distro/scripts/ki2-target-g-ir-compiler"
        ],
        "configure": [
          "install -Dm755 \"${KI2_REPO_ROOT}/distro/scripts/ki2-target-python3\" \"${KI2_BUILD_DIR}/target-python3\"",
          "install -Dm755 \"${KI2_REPO_ROOT}/distro/scripts/ki2-target-g-ir-scanner\" \"${KI2_BUILD_DIR}/tools/g-ir-scanner\"",
          "sed -i \"1c #!/usr/bin/env ${KI2_BUILD_DIR}/target-python3\" \"${KI2_SYSROOT}/usr/bin/g-ir-scanner\"",
          "install -m755 \"${KI2_SYSROOT}/usr/bin/g-ir-compiler\" \"${KI2_BUILD_DIR}/g-ir-compiler.real\"",
          "install -m755 \"${KI2_REPO_ROOT}/distro/scripts/ki2-target-g-ir-compiler\" \"${KI2_SYSROOT}/usr/bin/g-ir-compiler\"",
          "install -Dm755 \"${KI2_REPO_ROOT}/distro/scripts/ki2-target-pkg-config\" \"${KI2_BUILD_DIR}/target-pkg-config\"",
          "install -m644 \"${KI2_REPO_ROOT}/distro/specs/graphics-cross.ini\" \"${KI2_BUILD_DIR}/cross.ini\"",
          "sed -i -e \"s|@BUILD@|${KI2_BUILD_DIR}|g\" -e \"s|@REPO@|${KI2_REPO_ROOT}|g\" \"${KI2_BUILD_DIR}/cross.ini\"",
          "PATH=\"${KI2_BUILD_DIR}/tools:$PATH\" meson setup \"${KI2_BUILD_DIR}/graphene\" \"${KI2_SOURCE_DIR}\" --cross-file \"${KI2_BUILD_DIR}/cross.ini\" --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nofallback -Ddefault_library=shared -Dgobject_types=true -Dintrospection=enabled -Dgtk_doc=false -Dtests=true -Dinstalled_tests=false"
        ],
        "compile": [
          "meson compile -C \"${KI2_BUILD_DIR}/graphene\" -j \"${KI2_JOBS}\""
        ],
        "install": [
          "DESTDIR=\"${KI2_DESTDIR}\" meson install -C \"${KI2_BUILD_DIR}/graphene\"",
          "install -Dm644 \"${KI2_SOURCE_DIR}/LICENSE.txt\" \"${KI2_DESTDIR}/usr/share/licenses/graphene/LICENSE.txt\"",
          "test -s \"${KI2_DESTDIR}/usr/lib/girepository-1.0/Graphene-1.0.typelib\"",
          "readelf -d \"${KI2_DESTDIR}/usr/lib/libgraphene-1.0.so.0\" > \"${KI2_BUILD_DIR}/elf-dynamic.txt\" && ! grep -E \"RPATH|RUNPATH\" \"${KI2_BUILD_DIR}/elf-dynamic.txt\""
        ],
        "env": {
          "KI2_USE_TARGET_LOADER": "1",
          "GI_CROSS_LAUNCHER": "/bin/sh ${KI2_REPO_ROOT}/distro/scripts/ki2-target-run",
          "KI2_SYSROOT_LIBRARY_PATH": "${KI2_BUILD_DIR}/graphene/src:${KI2_SYSROOT_LIBRARY_PATH}",
          "CFLAGS": "--sysroot=${KI2_SYSROOT} ${KI2_SYSROOT_CPPFLAGS} -O2 -pipe -fstack-protector-strong -D_FORTIFY_SOURCE=2",
          "LDFLAGS": "--sysroot=${KI2_SYSROOT} -B${KI2_SYSROOT}/usr/lib64/ -B${KI2_SYSROOT}/lib64/ ${KI2_SYSROOT_LDFLAGS} -Wl,-z,relro,-z,now"
        }
      }
    }
  ]
}
