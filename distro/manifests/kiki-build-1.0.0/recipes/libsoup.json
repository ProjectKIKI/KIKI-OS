{
  "recipes": [
    {
      "name": "libsoup",
      "version": "3.6.6",
      "release": "3",
      "summary": "Native GNOME 50 desktop dependency",
      "license": "LGPL-2.1-or-later",
      "tier": "desktop",
      "architectures": [
        "x86_64"
      ],
      "source": {
        "type": "url",
        "url": "https://download.gnome.org/sources/libsoup/3.6/libsoup-3.6.6.tar.xz",
        "sha256": "51ed0ae06f9d5a40f401ff459e2e5f652f9a510b7730e1359ee66d14d4872740"
      },
      "dependencies": {
        "build": [
          "linux-headers",
          "gobject-introspection"
        ],
        "runtime": [
          "glib",
          "glib-networking",
          "glibc",
          "libpsl",
          "nghttp2",
          "sqlite",
          "zlib"
        ]
      },
      "build": {
        "system": "meson",
        "configure_options": [
          "-Dintrospection=enabled",
          "-Dvapi=disabled",
          "-Ddocs=disabled",
          "-Dtests=false",
          "-Dsysprof=disabled",
          "-Dgssapi=disabled",
          "-Dntlm=disabled",
          "-Dbrotli=disabled",
          "-Dtls_check=false"
        ]
      }
    }
  ]
}
