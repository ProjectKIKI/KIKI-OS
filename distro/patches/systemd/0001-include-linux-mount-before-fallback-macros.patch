diff --git a/src/basic/missing_syscall.h b/src/basic/missing_syscall.h
--- a/src/basic/missing_syscall.h
+++ b/src/basic/missing_syscall.h
@@ -4,6 +4,13 @@
 
 #include <errno.h>
 #include <fcntl.h>
+/*
+ * Linux 6.9 headers expose fsconfig command names as enum constants in
+ * linux/mount.h. Include that UAPI before the fallback macros below so later
+ * transitive includes do not expand those enum identifiers into numbers.
+ */
+#include <linux/mount.h>
+
 #if HAVE_LINUX_TIME_TYPES_H
 /* This header defines __kernel_timespec for us, but is only available since Linux 5.1, hence conditionally
  * include this. */
