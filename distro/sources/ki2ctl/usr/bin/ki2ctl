#!/usr/bin/env python3
"""Small HTTP-backed package manager for KIKI .ki2 repositories."""

from __future__ import annotations

import argparse
import base64
import copy
import contextlib
import datetime as dt
import hashlib
import hmac
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.error
import urllib.request
from dataclasses import dataclass
from pathlib import Path
from typing import Any


APP_VERSION = "0.1.0"
GENERATED_INFO_INDEX = "/usr/share/info/dir"
DEFAULT_ARCH = "x86_64"
DEFAULT_REPO_NAME = "default"
INSTALLED_SCHEMA = "ki2-installed-v1"
TRANSACTION_SCHEMA = "ki2-transaction-v1"
PACKAGE_GROUP_SCHEMA = "ki2-package-groups-v1"
HMAC_SIGNATURE_ALGORITHM = "hmac-sha256"
ED25519_SIGNATURE_ALGORITHM = "ed25519"
SIGNATURE_ALGORITHM = HMAC_SIGNATURE_ALGORITHM
UTC = dt.timezone.utc


class Ki2CtlError(RuntimeError):
    pass


@dataclass(frozen=True)
class Repo:
    name: str
    url: str
    verify_key: str = ""


def norm_url(url: str) -> str:
    value = url.strip()
    if not value:
        raise Ki2CtlError("repository URL is empty")
    if value.startswith(("http://", "https://", "file://")):
        return value.rstrip("/")
    path = Path(value).expanduser()
    if path.is_absolute() or value.startswith(".") or "/" in value or (os.altsep and os.altsep in value):
        return path.resolve().as_uri().rstrip("/")
    raise Ki2CtlError("repository URL must start with http://, https://, file://, or be a local path")


def root_join(root: Path, *parts: str) -> Path:
    cleaned = [part.strip("/") for part in parts if part]
    return root.joinpath(*cleaned)


def repo_config_dir(root: Path) -> Path:
    return root_join(root, "etc", "ki2", "repos.d")


def state_dir(root: Path) -> Path:
    return root_join(root, "var", "lib", "ki2")


def cache_dir(root: Path, arch: str) -> Path:
    return root_join(root, "var", "cache", "ki2", "packages", arch)


def repo_state_dir(root: Path, name: str) -> Path:
    return state_dir(root) / "repos" / name


def installed_db_path(root: Path) -> Path:
    return state_dir(root) / "installed.json"


def package_groups_path(root: Path, override: Path | None = None) -> Path:
    if override is not None:
        return override
    return root_join(root, "usr", "share", "ki2", "package-groups.json")


def transaction_dir(root: Path) -> Path:
    return state_dir(root) / "transactions"


def pending_hooks_path(root: Path) -> Path:
    return state_dir(root) / "pending-hooks.json"


def repo_file(root: Path, name: str) -> Path:
    return repo_config_dir(root) / f"{name}.repo"


def trust_dir(root: Path) -> Path:
    return root_join(root, "etc", "ki2", "trust")


def repository_policy(root: Path) -> dict[str, Any]:
    path = root_join(root, "etc", "ki2", "policy.json")
    if not path.exists():
        return {}
    try:
        value = read_json(path)
    except (OSError, json.JSONDecodeError) as exc:
        raise Ki2CtlError(f"invalid repository policy {path}: {exc}") from exc
    return value


def valid_repo_name(name: str) -> bool:
    return bool(re.fullmatch(r"[A-Za-z0-9._-]+", name)) and name not in (".", "..")


def write_json(path: Path, data: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp.replace(path)


def read_json(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text(encoding="utf-8"))


def string_array(value: Any, field: str) -> list[str]:
    if value is None:
        return []
    if not isinstance(value, list) or not all(isinstance(item, str) and item for item in value):
        raise Ki2CtlError(f"{field} must be a list of non-empty strings")
    return list(dict.fromkeys(value))


def load_package_groups(root: Path, override: Path | None = None) -> dict[str, dict[str, Any]]:
    path = package_groups_path(root, override)
    if not path.is_file():
        raise Ki2CtlError(f"package group catalog not found: {path}")
    data = read_json(path)
    if data.get("schema") != PACKAGE_GROUP_SCHEMA:
        raise Ki2CtlError(f"unsupported package group schema in {path}")
    raw_groups = data.get("groups")
    if not isinstance(raw_groups, list):
        raise Ki2CtlError(f"{path}: groups must be a list")
    groups: dict[str, dict[str, Any]] = {}
    for raw in raw_groups:
        if not isinstance(raw, dict):
            raise Ki2CtlError(f"{path}: group entries must be objects")
        group_id = str(raw.get("id", ""))
        if not valid_repo_name(group_id):
            raise Ki2CtlError(f"{path}: invalid package group id: {group_id}")
        if group_id in groups:
            raise Ki2CtlError(f"{path}: duplicate package group id: {group_id}")
        packages = raw.get("packages", {})
        services = raw.get("services", {})
        if not isinstance(packages, dict) or not isinstance(services, dict):
            raise Ki2CtlError(f"{path}: group {group_id} packages and services must be objects")
        normalized = dict(raw)
        normalized["requires"] = string_array(raw.get("requires"), f"group {group_id}.requires")
        normalized["packages"] = {
            section: string_array(packages.get(section), f"group {group_id}.packages.{section}")
            for section in ("mandatory", "default", "optional")
        }
        normalized["services"] = {
            "enable": string_array(services.get("enable"), f"group {group_id}.services.enable"),
            "disable": string_array(services.get("disable"), f"group {group_id}.services.disable"),
        }
        groups[group_id] = normalized
    for group_id, group in groups.items():
        for required in group["requires"]:
            if required not in groups:
                raise Ki2CtlError(f"group {group_id} requires unknown group {required}")
    return groups


def resolve_package_group(
    groups: dict[str, dict[str, Any]], group_id: str, *, with_optional: bool = False
) -> tuple[list[str], list[str], list[str], list[str]]:
    if group_id not in groups:
        raise Ki2CtlError(f"package group not found: {group_id}")
    ordered_groups: list[str] = []
    packages: list[str] = []
    services: list[str] = []
    disabled_services: list[str] = []
    visiting: set[str] = set()

    def visit(current: str) -> None:
        if current in ordered_groups:
            return
        if current in visiting:
            raise Ki2CtlError(f"package group dependency cycle at {current}")
        visiting.add(current)
        group = groups[current]
        for required in group["requires"]:
            visit(required)
        visiting.remove(current)
        ordered_groups.append(current)
        sections = ["mandatory", "default"] + (["optional"] if with_optional else [])
        for section in sections:
            for name in group["packages"][section]:
                if name not in packages:
                    packages.append(name)
        for unit in group["services"]["enable"]:
            if unit in disabled_services:
                disabled_services.remove(unit)
            if unit not in services:
                services.append(unit)
        for unit in group["services"]["disable"]:
            if unit in services:
                services.remove(unit)
            if unit not in disabled_services:
                disabled_services.append(unit)

    visit(group_id)
    return ordered_groups, packages, services, disabled_services


def http_get(url: str) -> bytes:
    request = urllib.request.Request(url, headers={"User-Agent": f"ki2ctl/{APP_VERSION}"})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return response.read()
    except urllib.error.HTTPError as exc:
        raise Ki2CtlError(f"HTTP {exc.code} while fetching {url}") from exc
    except urllib.error.URLError as exc:
        raise Ki2CtlError(f"cannot fetch {url}: {exc.reason}") from exc


def url_join(base: str, *parts: str) -> str:
    suffix = "/".join(part.strip("/") for part in parts if part)
    return f"{base.rstrip('/')}/{suffix}" if suffix else base.rstrip("/")


def file_sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def bytes_sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def canonical_json_bytes(data: dict[str, Any]) -> bytes:
    return json.dumps(data, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")


def signature_payload(metadata: dict[str, Any]) -> dict[str, Any]:
    payload = json.loads(json.dumps(metadata))
    security = dict(payload.get("security", {}))
    security["signature"] = None
    payload["security"] = security
    return payload


def read_verify_key(path: Path) -> bytes:
    raw = path.read_text(encoding="utf-8").strip()
    try:
        return bytes.fromhex(raw)
    except ValueError:
        return raw.encode("utf-8")


def verify_metadata_signature(metadata: dict[str, Any], key: bytes) -> bool:
    security = metadata.get("security", {})
    if not isinstance(security, dict):
        return False
    if security.get("algorithm") != SIGNATURE_ALGORITHM:
        return False
    signature = str(security.get("signature") or "")
    if not signature:
        return False
    expected = hmac.new(key, canonical_json_bytes(signature_payload(metadata)), hashlib.sha256).hexdigest()
    return hmac.compare_digest(signature, expected)


ED25519_Q = 2**255 - 19
ED25519_L = 2**252 + 27742317777372353535851937790883648493
ED25519_D = (-121665 * pow(121666, ED25519_Q - 2, ED25519_Q)) % ED25519_Q
ED25519_I = pow(2, (ED25519_Q - 1) // 4, ED25519_Q)
ED25519_BY = (4 * pow(5, ED25519_Q - 2, ED25519_Q)) % ED25519_Q
ED25519_DER_PREFIX = bytes.fromhex("302a300506032b6570032100")


def ed25519_xrecover(y: int) -> int:
    xx = (y * y - 1) * pow(ED25519_D * y * y + 1, ED25519_Q - 2, ED25519_Q)
    x = pow(xx % ED25519_Q, (ED25519_Q + 3) // 8, ED25519_Q)
    if (x * x - xx) % ED25519_Q != 0:
        x = (x * ED25519_I) % ED25519_Q
    if x & 1:
        x = ED25519_Q - x
    return x


ED25519_B = (ed25519_xrecover(ED25519_BY), ED25519_BY)


def ed25519_add(left: tuple[int, int], right: tuple[int, int]) -> tuple[int, int]:
    x1, y1 = left
    x2, y2 = right
    product = ED25519_D * x1 * x2 * y1 * y2
    x3 = (x1 * y2 + x2 * y1) * pow(1 + product, ED25519_Q - 2, ED25519_Q)
    y3 = (y1 * y2 + x1 * x2) * pow(1 - product, ED25519_Q - 2, ED25519_Q)
    return x3 % ED25519_Q, y3 % ED25519_Q


def ed25519_scalar_mult(point: tuple[int, int], scalar: int) -> tuple[int, int]:
    result = (0, 1)
    addend = point
    while scalar:
        if scalar & 1:
            result = ed25519_add(result, addend)
        addend = ed25519_add(addend, addend)
        scalar >>= 1
    return result


def ed25519_decode_point(encoded: bytes) -> tuple[int, int]:
    if len(encoded) != 32:
        raise ValueError("Ed25519 point must contain 32 bytes")
    value = int.from_bytes(encoded, "little")
    sign = value >> 255
    y = value & ((1 << 255) - 1)
    if y >= ED25519_Q:
        raise ValueError("Ed25519 point is not canonical")
    x = ed25519_xrecover(y)
    if (x & 1) != sign:
        x = ED25519_Q - x
    if x == 0 and sign:
        raise ValueError("Ed25519 point has an invalid sign bit")
    if (-x * x + y * y - 1 - ED25519_D * x * x * y * y) % ED25519_Q != 0:
        raise ValueError("Ed25519 point is not on the curve")
    return x, y


def parse_ed25519_public_key(data: bytes) -> tuple[bytes, bytes]:
    stripped = data.strip()
    if stripped.startswith(b"-----BEGIN PUBLIC KEY-----"):
        lines = [line for line in stripped.splitlines() if not line.startswith(b"-----")]
        der = base64.b64decode(b"".join(lines), validate=True)
        if not der.startswith(ED25519_DER_PREFIX) or len(der) != len(ED25519_DER_PREFIX) + 32:
            raise ValueError("public key is not Ed25519 SubjectPublicKeyInfo")
        return der[-32:], der
    if len(stripped) == 32:
        return stripped, ED25519_DER_PREFIX + stripped
    raw = base64.b64decode(stripped, validate=True)
    if len(raw) != 32:
        raise ValueError("Ed25519 public key must contain 32 bytes")
    return raw, ED25519_DER_PREFIX + raw


def verify_ed25519(public_key: bytes, message: bytes, signature: bytes) -> bool:
    if len(public_key) != 32 or len(signature) != 64:
        return False
    scalar = int.from_bytes(signature[32:], "little")
    if scalar >= ED25519_L:
        return False
    try:
        public_point = ed25519_decode_point(public_key)
        signature_point = ed25519_decode_point(signature[:32])
    except ValueError:
        return False
    identity = (0, 1)
    if ed25519_scalar_mult(public_point, 8) == identity:
        return False
    if ed25519_scalar_mult(public_point, ED25519_L) != identity:
        return False
    digest = hashlib.sha512(signature[:32] + public_key + message).digest()
    challenge = int.from_bytes(digest, "little") % ED25519_L
    return ed25519_scalar_mult(ED25519_B, scalar) == ed25519_add(
        signature_point, ed25519_scalar_mult(public_point, challenge)
    )


def verify_metadata_ed25519(metadata: dict[str, Any], public_key_path: Path) -> bool:
    security = metadata.get("security", {})
    if not isinstance(security, dict) or security.get("algorithm") != ED25519_SIGNATURE_ALGORITHM:
        return False
    try:
        signature = base64.b64decode(str(security.get("signature") or ""), validate=True)
    except (ValueError, TypeError):
        return False
    if len(signature) != 64:
        return False
    try:
        public_key, public_der = parse_ed25519_public_key(public_key_path.read_bytes())
    except (OSError, ValueError, TypeError):
        return False
    if str(security.get("key_id") or "") != hashlib.sha256(public_der).hexdigest()[:16]:
        return False
    return verify_ed25519(public_key, canonical_json_bytes(signature_payload(metadata)), signature)


def verify_metadata_with_key(metadata: dict[str, Any], key_path: Path) -> bool:
    algorithm = str(metadata.get("security", {}).get("algorithm") or "")
    if algorithm == ED25519_SIGNATURE_ALGORITHM:
        return verify_metadata_ed25519(metadata, key_path)
    if algorithm == HMAC_SIGNATURE_ALGORITHM:
        return verify_metadata_signature(metadata, read_verify_key(key_path))
    return False


def load_configured_repos(root: Path) -> list[Repo]:
    directory = repo_config_dir(root)
    repos: list[Repo] = []
    if not directory.exists():
        return repos
    for path in sorted(directory.glob("*.repo")):
        data = read_json(path)
        name = str(data.get("name") or path.stem)
        url = norm_url(str(data.get("url") or ""))
        verify_key = str(data.get("verify_key") or "")
        repos.append(Repo(name=name, url=url, verify_key=verify_key))
    return repos


def selected_repos(args: argparse.Namespace) -> list[Repo]:
    if args.repo:
        return [Repo(name="cli", url=norm_url(args.repo))]
    repos = load_configured_repos(args.root)
    if not repos:
        raise Ki2CtlError("no repository configured; run: ki2ctl repo set http://server/kiki")
    return repos


def fetch_repo_index_payload(repo: Repo, arch: str) -> tuple[dict[str, Any], bytes]:
    url = url_join(repo.url, "repo", f"index.{arch}.json")
    data = http_get(url)
    index = json.loads(data.decode("utf-8"))
    if index.get("schema") != "ki2-repository-v1":
        raise Ki2CtlError(f"{repo.name}: unsupported repository schema")
    if index.get("arch") not in (arch, None):
        raise Ki2CtlError(f"{repo.name}: repository arch {index.get('arch')} does not match {arch}")
    return index, data


def fetch_repo_index(repo: Repo, arch: str) -> dict[str, Any]:
    index, _data = fetch_repo_index_payload(repo, arch)
    return index


def fetch_repo_metadata(repo: Repo, arch: str) -> dict[str, Any]:
    url = url_join(repo.url, "repo", f"metadata.{arch}.json")
    data = http_get(url)
    metadata = json.loads(data.decode("utf-8"))
    if metadata.get("schema") != "ki2-repository-metadata-v1":
        raise Ki2CtlError(f"{repo.name}: unsupported repository metadata schema")
    if metadata.get("arch") not in (arch, None):
        raise Ki2CtlError(f"{repo.name}: repository metadata arch {metadata.get('arch')} does not match {arch}")
    return metadata


def save_repo_index(root: Path, repo: Repo, arch: str, index: dict[str, Any]) -> Path:
    path = repo_state_dir(root, repo.name) / f"index.{arch}.json"
    payload = dict(index)
    payload["repo_name"] = repo.name
    payload["repo_url"] = repo.url
    write_json(path, payload)
    return path


def save_repo_metadata(root: Path, repo: Repo, arch: str, metadata: dict[str, Any]) -> Path:
    path = repo_state_dir(root, repo.name) / f"metadata.{arch}.json"
    payload = dict(metadata)
    payload["repo_name"] = repo.name
    payload["repo_url"] = repo.url
    write_json(path, payload)
    return path


def load_saved_indexes(root: Path, arch: str) -> list[tuple[Repo, dict[str, Any]]]:
    repos_by_name = {repo.name: repo for repo in load_configured_repos(root)}
    result: list[tuple[Repo, dict[str, Any]]] = []
    base = state_dir(root) / "repos"
    if not base.exists():
        return result
    for path in sorted(base.glob(f"*/index.{arch}.json")):
        index = read_json(path)
        name = str(index.get("repo_name") or path.parent.name)
        url = str(index.get("repo_url") or "")
        repo = repos_by_name.get(name, Repo(name=name, url=norm_url(url))) if url else repos_by_name.get(name)
        if repo is not None:
            result.append((repo, index))
    return result


def indexes_for_command(args: argparse.Namespace) -> list[tuple[Repo, dict[str, Any]]]:
    if args.repo:
        repo = Repo(name="cli", url=norm_url(args.repo))
        index = fetch_repo_index(repo, args.arch)
        save_repo_index(args.root, repo, args.arch, index)
        return [(repo, index)]
    indexes = load_saved_indexes(args.root, args.arch)
    if not indexes:
        raise Ki2CtlError("no local repository index; run: ki2ctl update")
    return indexes


def rooted_verify_key_path(root: Path, value: str) -> Path:
    if value.startswith(("/", "\\")):
        return root / value.lstrip("/\\")
    key = Path(value).expanduser()
    if key.is_absolute():
        rooted = root_join(root, str(key).lstrip("/"))
        if rooted.exists():
            return rooted
        return key
    if len(key.parts) == 1:
        return trust_dir(root) / key
    return root_join(root, str(key))


def repo_verify_key_path(
    root: Path, repo: Repo, explicit_key: Path | None, policy: dict[str, Any] | None = None
) -> Path | None:
    if explicit_key is not None:
        return explicit_key
    if repo.verify_key:
        return rooted_verify_key_path(root, repo.verify_key)
    candidates: list[Path] = []
    trusted_key = str((policy or {}).get("trusted_key") or "")
    if trusted_key:
        candidates.append(rooted_verify_key_path(root, trusted_key))
    candidates.extend([
        trust_dir(root) / f"{repo.name}.ed25519.pub",
        trust_dir(root) / "stage3-repo.ed25519.pub",
        trust_dir(root) / f"{repo.name}.hmac",
        trust_dir(root) / "stage2-v2-repo.hmac",
    ])
    for candidate in candidates:
        if candidate.exists():
            return candidate
    return None


def natural_key(value: Any) -> tuple[tuple[int, Any], ...]:
    parts: list[tuple[int, Any]] = []
    for part in re.split(r"([0-9]+)", str(value)):
        if not part:
            continue
        parts.append((0, int(part)) if part.isdigit() else (1, part))
    return tuple(parts)


def package_sort_key(pkg: dict[str, Any]) -> tuple[Any, ...]:
    return (
        natural_key(pkg.get("version", "")),
        natural_key(pkg.get("release", "")),
        str(pkg.get("file", "")),
    )


def installed_sort_key(pkg: dict[str, Any]) -> tuple[Any, ...]:
    return (
        natural_key(pkg.get("version", "")),
        natural_key(pkg.get("release", "")),
        str(pkg.get("file", "")),
    )


def package_catalog(indexes: list[tuple[Repo, dict[str, Any]]]) -> dict[str, tuple[Repo, dict[str, Any]]]:
    catalog: dict[str, tuple[Repo, dict[str, Any]]] = {}
    for repo, index in indexes:
        for pkg in index.get("packages", []):
            name = str(pkg.get("name", ""))
            if not name:
                continue
            current = catalog.get(name)
            if current is None or package_sort_key(pkg) > package_sort_key(current[1]):
                catalog[name] = (repo, pkg)
    return catalog


def runtime_deps(pkg: dict[str, Any]) -> list[str]:
    deps = pkg.get("dependencies", {})
    if isinstance(deps, dict):
        raw = deps.get("runtime", [])
    else:
        raw = pkg.get("runtime_dependencies", [])
    if not isinstance(raw, list):
        return []
    return [str(item) for item in raw if str(item)]


def resolve_packages(catalog: dict[str, tuple[Repo, dict[str, Any]]], roots: list[str]) -> list[tuple[Repo, dict[str, Any]]]:
    ordered: list[tuple[Repo, dict[str, Any]]] = []
    seen: set[str] = set()
    visiting: set[str] = set()

    def visit(name: str) -> None:
        if name in seen:
            return
        if name in visiting:
            raise Ki2CtlError(f"dependency cycle at {name}")
        if name not in catalog:
            raise Ki2CtlError(f"package not found: {name}")
        visiting.add(name)
        repo, pkg = catalog[name]
        for dep in runtime_deps(pkg):
            visit(dep)
        visiting.remove(name)
        seen.add(name)
        ordered.append((repo, pkg))

    for root in roots:
        visit(root)
    return ordered


def fetch_package(repo: Repo, pkg: dict[str, Any], root: Path, arch: str) -> Path:
    filename = str(pkg.get("file") or "")
    expected = str(pkg.get("sha256") or "")
    if not filename:
        raise Ki2CtlError(f"{pkg.get('name')}: package file is missing in index")
    target = cache_dir(root, arch) / filename
    if target.exists() and (not expected or file_sha256(target) == expected):
        return target

    urls = [
        url_join(repo.url, "packages", filename),
        url_join(repo.url, "packages", arch, filename),
        url_join(repo.url, "kiki", "packages", arch, filename),
    ]
    last_error: Exception | None = None
    for url in urls:
        try:
            data = http_get(url)
            if expected and bytes_sha256(data) != expected:
                raise Ki2CtlError(f"{filename}: sha256 mismatch from {url}")
            target.parent.mkdir(parents=True, exist_ok=True)
            tmp = target.with_suffix(target.suffix + ".tmp")
            tmp.write_bytes(data)
            tmp.replace(target)
            return target
        except Ki2CtlError as exc:
            last_error = exc
    raise Ki2CtlError(str(last_error) if last_error else f"cannot fetch {filename}")


def safe_target(root: Path, rel: str) -> Path:
    rel_path = Path(rel)
    if rel_path.is_absolute() or ".." in rel_path.parts:
        raise Ki2CtlError(f"unsafe package path: {rel}")
    root_resolved = root.resolve()
    target = (root / rel_path).resolve(strict=False)
    if target != root_resolved and root_resolved not in target.parents:
        raise Ki2CtlError(f"package path escapes root: {rel}")
    return target


def package_payload_entries(package: Path) -> list[dict[str, str]]:
    entries: list[dict[str, str]] = []
    with tarfile.open(package, "r:gz") as tar:
        for member in tar.getmembers():
            if member.name == "manifest.json" or not member.name.startswith("rootfs/"):
                continue
            rel = member.name[len("rootfs/") :]
            if not rel:
                continue
            if "/" + rel == GENERATED_INFO_INDEX:
                continue
            kind = "other"
            if member.isdir():
                kind = "dir"
            elif member.issym():
                kind = "symlink"
            elif member.islnk():
                kind = "hardlink"
            elif member.isfile():
                kind = "file"
            if kind == "other":
                continue
            entries.append({"path": "/" + rel, "kind": kind})
    return entries


def extract_package(package: Path, root: Path) -> list[str]:
    extracted: list[str] = []
    root.mkdir(parents=True, exist_ok=True)
    with tarfile.open(package, "r:gz") as tar:
        members = tar.getmembers()
        for member in members:
            if member.name == "manifest.json" or not member.name.startswith("rootfs/"):
                continue
            rel = member.name[len("rootfs/") :]
            if not rel:
                continue
            if "/" + rel == GENERATED_INFO_INDEX:
                continue
            target = safe_target(root, rel)
            if member.isdir():
                target.mkdir(parents=True, exist_ok=True)
                with contextlib.suppress(PermissionError):
                    target.chmod(member.mode)
                continue
            target.parent.mkdir(parents=True, exist_ok=True)
            if member.issym():
                if target.exists() or target.is_symlink():
                    target.unlink()
                os.symlink(member.linkname, target)
            elif member.islnk():
                link_rel = member.linkname[len("rootfs/") :] if member.linkname.startswith("rootfs/") else member.linkname
                link_target = safe_target(root, link_rel)
                if target.exists() or target.is_symlink():
                    target.unlink()
                os.link(link_target, target)
            elif member.isfile():
                handle = tar.extractfile(member)
                if handle is None:
                    continue
                with target.open("wb") as out:
                    shutil.copyfileobj(handle, out)
                with contextlib.suppress(PermissionError):
                    target.chmod(member.mode)
            else:
                continue
            if hasattr(os, "chown"):
                with contextlib.suppress(PermissionError):
                    os.chown(target, member.uid, member.gid, follow_symlinks=False)
            extracted.append("/" + rel)
    return extracted


def load_installed(root: Path) -> dict[str, Any]:
    path = installed_db_path(root)
    if not path.exists():
        return {"schema": INSTALLED_SCHEMA, "packages": {}, "groups": {}}
    db = read_json(path)
    db.setdefault("groups", {})
    packages = db.setdefault("packages", {})
    if isinstance(packages, dict):
        for record in packages.values():
            if isinstance(record, dict) and "reasons" not in record:
                # Older databases did not track provenance. Preserve those packages
                # conservatively as explicitly installed during the in-memory migration.
                record["reasons"] = ["explicit"]
    return db


def save_installed(root: Path, db: dict[str, Any]) -> None:
    write_json(installed_db_path(root), db)
    installed_list = sorted(db.get("packages", {}))
    list_path = state_dir(root) / "installed.list"
    list_path.parent.mkdir(parents=True, exist_ok=True)
    list_path.write_text("\n".join(installed_list) + ("\n" if installed_list else ""), encoding="utf-8")


def load_pending_hooks(root: Path) -> dict[str, Any]:
    path = pending_hooks_path(root)
    if not path.exists():
        return {"schema": "ki2-pending-hooks-v1", "hooks": []}
    return read_json(path)


def save_pending_hooks(root: Path, data: dict[str, Any]) -> None:
    write_json(pending_hooks_path(root), data)


def detect_post_install_hooks(files: list[str]) -> list[str]:
    hooks: set[str] = set()
    for path in files:
        if path.startswith("/usr/share/glib-2.0/schemas/") and path.endswith((".xml", ".gschema.override")):
            hooks.add("glib-compile-schemas")
        if re.search(r"/(?:lib|lib64|usr/lib|usr/lib64)/.*\.so(?:\.|$)", path):
            hooks.add("ldconfig")
        if path.startswith("/usr/lib/systemd/system/") or path.startswith("/etc/systemd/system/"):
            hooks.add("systemd-daemon-reload")
        if path.startswith("/usr/lib/tmpfiles.d/") or path.startswith("/etc/tmpfiles.d/"):
            hooks.add("systemd-tmpfiles-create")
        if path.startswith("/usr/share/info/") and (
                path.endswith((".info", ".info.gz", ".info.xz", ".info.bz2")) or path == "/usr/share/info/dir"):
            hooks.add("info-index-rebuild")
    return sorted(hooks)


def record_pending_hooks(root: Path, package_name: str, files: list[str], *, phase: str = "post-install") -> None:
    actions = detect_post_install_hooks(files)
    if not actions:
        return
    data = load_pending_hooks(root)
    existing = {
        (item.get("action"), item.get("package"), item.get("phase", "post-install"))
        for item in data.get("hooks", [])
        if isinstance(item, dict) and item.get("status") != "applied"
    }
    hooks = data.setdefault("hooks", [])
    for action in actions:
        key = (action, package_name, phase)
        if key in existing:
            continue
        hooks.append(
            {
                "action": action,
                "package": package_name,
                "phase": phase,
                "created_at": dt.datetime.now(UTC).isoformat(),
                "status": "pending",
            }
        )
    save_pending_hooks(root, data)


def package_version_label(pkg: dict[str, Any]) -> str:
    return f"{pkg.get('version', '')}-{pkg.get('release', '')}"


def installed_matches(root: Path, pkg: dict[str, Any]) -> bool:
    record = load_installed(root).get("packages", {}).get(str(pkg.get("name", "")))
    if not isinstance(record, dict):
        return False
    return package_version_label(record) == package_version_label(pkg)


def record_install(
    root: Path,
    repo: Repo,
    pkg: dict[str, Any],
    files: list[str],
    reasons: list[str] | None = None,
) -> None:
    db = load_installed(root)
    packages = db.setdefault("packages", {})
    previous = packages.get(str(pkg["name"]), {})
    previous_reasons = previous.get("reasons", []) if isinstance(previous, dict) else []
    merged_reasons = sorted(set(string_array(previous_reasons, f"package {pkg['name']}.reasons")) | set(reasons or []))
    packages[str(pkg["name"])] = {
        "name": pkg["name"],
        "version": pkg.get("version", ""),
        "release": pkg.get("release", ""),
        "arch": pkg.get("arch", ""),
        "file": pkg.get("file", ""),
        "sha256": pkg.get("sha256", ""),
        "summary": pkg.get("summary", ""),
        "dependencies": pkg.get("dependencies", {}),
        "repository": {"name": repo.name, "url": repo.url},
        "installed_at": dt.datetime.now(UTC).isoformat(),
        "files": sorted(files),
        "reasons": merged_reasons,
    }
    save_installed(root, db)


def add_install_reasons(root: Path, package_name: str, reasons: list[str]) -> None:
    if not reasons:
        return
    db = load_installed(root)
    record = db.get("packages", {}).get(package_name)
    if not isinstance(record, dict):
        return
    current = string_array(record.get("reasons"), f"package {package_name}.reasons")
    record["reasons"] = sorted(set(current) | set(reasons))
    save_installed(root, db)


def file_owners(db: dict[str, Any]) -> dict[str, str]:
    return {path: sorted(owners)[0] for path, owners in file_owner_sets(db).items() if owners}


def file_owner_sets(db: dict[str, Any]) -> dict[str, set[str]]:
    owner_sets: dict[str, set[str]] = {}
    packages = db.get("packages", {})
    if not isinstance(packages, dict):
        return owner_sets
    for name, record in packages.items():
        if not isinstance(record, dict):
            continue
        for path in record.get("files", []):
            if str(path) == GENERATED_INFO_INDEX:
                continue
            owner_sets.setdefault(str(path), set()).add(str(name))
    return owner_sets


def reverse_dependency_blocks(packages: dict[str, Any], removing: set[str]) -> list[str]:
    blocks: list[str] = []
    for name, record in sorted(packages.items()):
        if name in removing or not isinstance(record, dict):
            continue
        deps = set(runtime_deps(record))
        for dep in sorted(deps & removing):
            blocks.append(f"{dep}: required by installed package {name}")
    return blocks


def detect_file_conflicts(root: Path, db: dict[str, Any], planned: list[tuple[Repo, dict[str, Any], Path]]) -> list[str]:
    owners = file_owner_sets(db)
    planned_owners: dict[str, str] = {}
    conflicts: list[str] = []
    for _repo, pkg, package_path in planned:
        package_name = str(pkg.get("name", ""))
        for entry in package_payload_entries(package_path):
            path = entry["path"]
            kind = entry["kind"]
            target = safe_target(root, path.lstrip("/"))
            planned_owner = planned_owners.get(path)
            if planned_owner and planned_owner != package_name:
                # Stage 2 bootstrap packages can share copied runtime libraries.
                # The transaction is ordered, and remove preserves shared owners.
                continue
            if kind != "dir":
                planned_owners[path] = package_name
            exists = target.exists() or target.is_symlink()
            if not exists:
                continue
            existing_owners = owners.get(path, set())
            conflicting_owners = sorted(owner for owner in existing_owners if owner != package_name)
            if conflicting_owners:
                conflicts.append(f"{path}: owned by installed package {', '.join(conflicting_owners)}, cannot install {package_name}")
            elif not existing_owners:
                if kind == "dir" and target.is_dir() and not target.is_symlink():
                    continue
                conflicts.append(f"{path}: existing unowned path would be overwritten by {package_name}")
    return conflicts


def transaction_id(action: str) -> str:
    stamp = dt.datetime.now(UTC).strftime("%Y%m%dT%H%M%S%fZ")
    return f"{stamp}-{action}"


def transaction_path(root: Path, txid: str) -> Path:
    return transaction_dir(root) / f"{txid}.json"


def begin_transaction(root: Path, action: str, plan: list[tuple[Repo, dict[str, Any], Path]]) -> dict[str, Any]:
    txid = transaction_id(action)
    tx = {
        "schema": TRANSACTION_SCHEMA,
        "id": txid,
        "action": action,
        "status": "running",
        "started_at": dt.datetime.now(UTC).isoformat(),
        "finished_at": None,
        "packages": [
            {
                "name": pkg.get("name", ""),
                "version": pkg.get("version", ""),
                "release": pkg.get("release", ""),
                "file": pkg.get("file", ""),
                "repository": repo.name,
            }
            for repo, pkg, _package_path in plan
        ],
        "events": [],
        "backups": [],
    }
    write_json(transaction_path(root, txid), tx)
    return tx


def update_transaction(root: Path, tx: dict[str, Any]) -> None:
    write_json(transaction_path(root, str(tx["id"])), tx)


def backup_root(root: Path, tx: dict[str, Any]) -> Path:
    return transaction_dir(root) / str(tx["id"]) / "backup"


def remember_backup(root: Path, tx: dict[str, Any], path: str) -> None:
    if any(item.get("path") == path for item in tx.get("backups", [])):
        return
    target = safe_target(root, path.lstrip("/"))
    record: dict[str, Any] = {"path": path, "existed": target.exists() or target.is_symlink()}
    if target.is_symlink():
        record["kind"] = "symlink"
        record["target"] = os.readlink(target)
    elif target.is_file():
        record["kind"] = "file"
        backup = backup_root(root, tx) / path.lstrip("/")
        backup.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(target, backup)
        record["backup"] = str(backup.relative_to(transaction_dir(root) / str(tx["id"])))
    elif target.is_dir():
        record["kind"] = "dir"
    else:
        record["kind"] = "missing"
    tx.setdefault("backups", []).append(record)


def prepare_backups(root: Path, tx: dict[str, Any], planned: list[tuple[Repo, dict[str, Any], Path]]) -> None:
    remember_backup(root, tx, "/" + pending_hooks_path(root).relative_to(root).as_posix())
    for _repo, _pkg, package_path in planned:
        for entry in package_payload_entries(package_path):
            if entry["kind"] == "dir":
                continue
            remember_backup(root, tx, entry["path"])
    tx.setdefault("events", []).append({"event": "backup-prepared", "count": len(tx.get("backups", []))})
    update_transaction(root, tx)


def prepare_remove_backups(root: Path, tx: dict[str, Any], records: list[dict[str, Any]]) -> None:
    remember_backup(root, tx, "/" + pending_hooks_path(root).relative_to(root).as_posix())
    for record in records:
        for path in record.get("files", []):
            remember_backup(root, tx, str(path))
    tx.setdefault("events", []).append({"event": "backup-prepared", "count": len(tx.get("backups", []))})
    update_transaction(root, tx)


def remove_path_for_rollback(target: Path) -> None:
    if target.is_dir() and not target.is_symlink():
        with contextlib.suppress(OSError):
            target.rmdir()
    else:
        with contextlib.suppress(FileNotFoundError):
            target.unlink()


def prune_empty_parent_dirs(root: Path, target: Path) -> None:
    root_resolved = root.resolve()
    current = target.resolve(strict=False)
    while current != root_resolved and root_resolved in current.parents:
        with contextlib.suppress(OSError):
            current.rmdir()
        parent = current.parent
        if parent == current:
            break
        current = parent


def rollback_transaction(root: Path, tx: dict[str, Any], db_before: dict[str, Any]) -> None:
    for record in reversed(tx.get("backups", [])):
        path = str(record.get("path", ""))
        if not path:
            continue
        target = safe_target(root, path.lstrip("/"))
        if not record.get("existed"):
            remove_path_for_rollback(target)
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        kind = record.get("kind")
        if kind == "file":
            remove_path_for_rollback(target)
            backup = transaction_dir(root) / str(tx["id"]) / str(record.get("backup", ""))
            shutil.copy2(backup, target)
        elif kind == "symlink":
            remove_path_for_rollback(target)
            os.symlink(str(record.get("target", "")), target)
        elif kind == "dir":
            target.mkdir(parents=True, exist_ok=True)
    save_installed(root, db_before)
    tx["status"] = "rolled-back"
    tx["finished_at"] = dt.datetime.now(UTC).isoformat()
    tx.setdefault("events", []).append({"event": "rollback-complete"})
    update_transaction(root, tx)


def finish_transaction(root: Path, tx: dict[str, Any], status: str) -> None:
    tx["status"] = status
    tx["finished_at"] = dt.datetime.now(UTC).isoformat()
    update_transaction(root, tx)


def install_plan(args: argparse.Namespace, names: list[str]) -> list[tuple[Repo, dict[str, Any]]]:
    catalog = package_catalog(indexes_for_command(args))
    return resolve_packages(catalog, names)


def explicit_install_reasons(args: argparse.Namespace, names: list[str]) -> dict[str, list[str]]:
    catalog = package_catalog(indexes_for_command(args))
    reasons: dict[str, set[str]] = {}
    for root_name in names:
        for _repo, pkg in resolve_packages(catalog, [root_name]):
            package_name = str(pkg.get("name", ""))
            reason = "explicit" if package_name == root_name else f"dependency:{root_name}"
            reasons.setdefault(package_name, set()).add(reason)
    return {name: sorted(values) for name, values in reasons.items()}


def execute_install_plan(
    args: argparse.Namespace,
    plan: list[tuple[Repo, dict[str, Any]]],
    *,
    skip_current: bool = True,
    reasons_by_package: dict[str, list[str]] | None = None,
) -> None:
    db_before = load_installed(args.root)
    reasons_by_package = reasons_by_package or {}
    planned: list[tuple[Repo, dict[str, Any], Path]] = []
    skipped_reasons: list[tuple[str, list[str]]] = []
    for repo, pkg in plan:
        if skip_current and not getattr(args, "reinstall", False) and installed_matches(args.root, pkg):
            package_name = str(pkg.get("name", ""))
            skipped_reasons.append((package_name, reasons_by_package.get(package_name, [])))
            print(f"already installed {pkg['name']} {package_version_label(pkg)}")
            continue
        planned.append((repo, pkg, fetch_package(repo, pkg, args.root, args.arch)))
    if not planned:
        for package_name, reasons in skipped_reasons:
            add_install_reasons(args.root, package_name, reasons)
        return
    conflicts = detect_file_conflicts(args.root, db_before, planned)
    if conflicts:
        raise Ki2CtlError("file conflicts:\n" + "\n".join(f"  {item}" for item in conflicts))
    tx = begin_transaction(args.root, args.command, planned)
    try:
        prepare_backups(args.root, tx, planned)
        for repo, pkg, package_path in planned:
            files = extract_package(package_path, args.root)
            package_name = str(pkg.get("name", ""))
            record_install(args.root, repo, pkg, files, reasons_by_package.get(package_name, []))
            record_pending_hooks(args.root, str(pkg.get("name", "")), files)
            tx.setdefault("events", []).append({"event": "installed", "package": pkg.get("name", ""), "files": len(files)})
            update_transaction(args.root, tx)
            print(f"installed {pkg['name']} ({len(files)} files)")
    except Exception as exc:
        tx.setdefault("events", []).append({"event": "error", "message": str(exc)})
        update_transaction(args.root, tx)
        rollback_transaction(args.root, tx, db_before)
        raise
    finish_transaction(args.root, tx, "succeeded")
    for package_name, reasons in skipped_reasons:
        add_install_reasons(args.root, package_name, reasons)


def command_repo_set(args: argparse.Namespace) -> None:
    name = args.name or DEFAULT_REPO_NAME
    if not valid_repo_name(name):
        raise Ki2CtlError(f"invalid repository name: {name}")
    data = {
        "schema": "ki2-repo-config-v1",
        "name": name,
        "url": norm_url(args.url),
    }
    if args.verify_key:
        data["verify_key"] = str(args.verify_key)
    path = repo_file(args.root, name)
    write_json(path, data)
    print(f"repo {name}: {data['url']}")
    if args.verify_key:
        print(f"repo {name}: verify-key {args.verify_key}")


def command_repo_remove(args: argparse.Namespace) -> None:
    name = args.name or DEFAULT_REPO_NAME
    if not valid_repo_name(name):
        raise Ki2CtlError(f"invalid repository name: {name}")
    removed = False
    path = repo_file(args.root, name)
    if path.exists():
        path.unlink()
        removed = True
    state = repo_state_dir(args.root, name)
    if state.exists():
        shutil.rmtree(state)
        removed = True
    if removed:
        print(f"removed repo {name}")
    else:
        print(f"repo {name} is not configured")


def command_repo_list(args: argparse.Namespace) -> None:
    repos = load_configured_repos(args.root)
    if not repos:
        print("no repositories configured")
        return
    for repo in repos:
        print(f"{repo.name}\t{repo.url}")


def command_update(args: argparse.Namespace) -> None:
    policy = repository_policy(args.root)
    require_signature = args.require_signature or policy.get("require_repository_signature") is True
    for repo in selected_repos(args):
        metadata: dict[str, Any] | None = None
        verify_key = None if args.no_verify else repo_verify_key_path(args.root, repo, args.verify_key, policy)
        if verify_key is not None:
            if not verify_key.exists():
                raise Ki2CtlError(f"{repo.name}: repository verify key not found: {verify_key}")
            metadata = fetch_repo_metadata(repo, args.arch)
            required_algorithm = str(policy.get("signature_algorithm") or "")
            actual_algorithm = str(metadata.get("security", {}).get("algorithm") or "")
            if required_algorithm and actual_algorithm != required_algorithm:
                raise Ki2CtlError(
                    f"{repo.name}: repository signature algorithm {actual_algorithm or 'none'} "
                    f"does not satisfy policy {required_algorithm}"
                )
            if not verify_metadata_with_key(metadata, verify_key):
                raise Ki2CtlError(f"{repo.name}: repository metadata signature verification failed")
            save_repo_metadata(args.root, repo, args.arch, metadata)
        elif require_signature and not args.no_verify:
            raise Ki2CtlError(f"{repo.name}: repository signature verification key is required")
        index, index_payload = fetch_repo_index_payload(repo, args.arch)
        if metadata is not None:
            expected = str(metadata.get("index", {}).get("sha256") or "")
            actual = bytes_sha256(index_payload)
            if expected and expected != actual:
                raise Ki2CtlError(f"{repo.name}: repository index sha256 does not match signed metadata")
        path = save_repo_index(args.root, repo, args.arch, index)
        suffix = " (metadata verified)" if metadata is not None else ""
        print(f"{repo.name}: {len(index.get('packages', []))} packages -> {path}{suffix}")


def command_search(args: argparse.Namespace) -> None:
    term = args.term.lower()
    catalog = package_catalog(indexes_for_command(args))
    for name, (_repo, pkg) in sorted(catalog.items()):
        text = f"{name} {pkg.get('summary', '')}".lower()
        if term in text:
            print(f"{name}\t{pkg.get('version')}-{pkg.get('release')}\t{pkg.get('summary', '')}")


def command_info(args: argparse.Namespace) -> None:
    catalog = package_catalog(indexes_for_command(args))
    if args.name not in catalog:
        raise Ki2CtlError(f"package not found: {args.name}")
    repo, pkg = catalog[args.name]
    print(f"Name    : {pkg.get('name')}")
    print(f"Version : {pkg.get('version')}-{pkg.get('release')}")
    print(f"Arch    : {pkg.get('arch')}")
    print(f"Repo    : {repo.name} ({repo.url})")
    print(f"Summary : {pkg.get('summary', '')}")
    deps = runtime_deps(pkg)
    print("Runtime :", ", ".join(deps) if deps else "-")
    print(f"File    : {pkg.get('file')}")
    print(f"SHA256  : {pkg.get('sha256', '')}")


def group_catalog_for_command(args: argparse.Namespace) -> dict[str, dict[str, Any]]:
    return load_package_groups(args.root, getattr(args, "group_file", None))


def command_group_list(args: argparse.Namespace) -> None:
    groups = group_catalog_for_command(args)
    installed_groups = load_installed(args.root).get("groups", {})
    for group_id, group in groups.items():
        status = "installed" if group_id in installed_groups else "available"
        print(f"{group_id}\t{status}\t{group.get('name_ko', group_id)}")


def command_group_info(args: argparse.Namespace) -> None:
    groups = group_catalog_for_command(args)
    if args.name not in groups:
        raise Ki2CtlError(f"package group not found: {args.name}")
    group = groups[args.name]
    resolved_groups, resolved_packages, services, disabled_services = resolve_package_group(
        groups, args.name, with_optional=True
    )
    installed = args.name in load_installed(args.root).get("groups", {})
    print(f"ID          : {args.name}")
    print(f"Name        : {group.get('name_ko', args.name)}")
    print(f"Description : {group.get('description_ko', '')}")
    print(f"Status      : {'installed' if installed else 'available'}")
    print("Requires    :", ", ".join(group["requires"]) if group["requires"] else "-")
    for section in ("mandatory", "default", "optional"):
        values = group["packages"][section]
        print(f"{section.capitalize():12}:", ", ".join(values) if values else "-")
    print("Resolved    :", ", ".join(resolved_groups))
    print("Packages    :", ", ".join(resolved_packages) if resolved_packages else "-")
    print("Services    :", ", ".join(services) if services else "-")
    print("Disable     :", ", ".join(disabled_services) if disabled_services else "-")


def group_reason(group_id: str) -> str:
    return f"group:{group_id}"


def record_group_install(
    root: Path,
    group_id: str,
    resolved_groups: list[str],
    package_names: list[str],
    services: list[str],
    disabled_services: list[str],
    *,
    with_optional: bool,
) -> None:
    db = load_installed(root)
    db.setdefault("groups", {})[group_id] = {
        "id": group_id,
        "installed_at": dt.datetime.now(UTC).isoformat(),
        "resolved_groups": resolved_groups,
        "packages": package_names,
        "services": services,
        "disabled_services": disabled_services,
        "with_optional": with_optional,
    }
    save_installed(root, db)


def command_group_install(args: argparse.Namespace) -> None:
    groups = group_catalog_for_command(args)
    resolved_groups, roots, services, disabled_services = resolve_package_group(
        groups, args.name, with_optional=args.with_optional
    )
    plan = install_plan(args, roots)
    resolved_package_names = [str(pkg.get("name", "")) for _repo, pkg in plan]
    for _repo, pkg in plan:
        print(f"{pkg['name']} {package_version_label(pkg)} [{group_reason(args.name)}]")
    if services:
        print("enable services:", ", ".join(services))
    if disabled_services:
        print("disable services:", ", ".join(disabled_services))
    if args.dry_run:
        return
    reasons = {name: [group_reason(args.name)] for name in resolved_package_names}
    execute_install_plan(args, plan, reasons_by_package=reasons)
    record_group_install(
        args.root,
        args.name,
        resolved_groups,
        resolved_package_names,
        services,
        disabled_services,
        with_optional=args.with_optional,
    )


def removable_group_packages(db: dict[str, Any], group_id: str, recorded: list[str]) -> tuple[set[str], set[str]]:
    packages = db.get("packages", {})
    reason = group_reason(group_id)
    candidates: set[str] = set()
    preserved: set[str] = set()
    for name in recorded:
        record = packages.get(name)
        if not isinstance(record, dict):
            continue
        remaining_reasons = set(record.get("reasons", [])) - {reason}
        if remaining_reasons:
            preserved.add(name)
        else:
            candidates.add(name)

    changed = True
    while changed:
        changed = False
        for name, record in packages.items():
            if name in candidates or not isinstance(record, dict):
                continue
            needed = set(runtime_deps(record)) & candidates
            if needed:
                candidates -= needed
                preserved |= needed
                changed = True
    return candidates, preserved


def command_group_remove(args: argparse.Namespace) -> None:
    db = load_installed(args.root)
    group_record = db.get("groups", {}).get(args.name)
    if not isinstance(group_record, dict):
        raise Ki2CtlError(f"package group is not installed: {args.name}")
    recorded = string_array(group_record.get("packages"), f"installed group {args.name}.packages")
    removing, preserved = removable_group_packages(db, args.name, recorded)
    for name in sorted(removing):
        print(f"remove package {name}")
    for name in sorted(preserved):
        print(f"preserve package {name} (another installation reason or dependency remains)")
    if args.keep_packages:
        removing.clear()
    if args.dry_run:
        return

    if removing:
        remove_args = copy.copy(args)
        remove_args.command = "group-remove"
        remove_args.names = sorted(removing)
        remove_args.force = False
        remove_args.dry_run = False
        command_remove(remove_args)

    db = load_installed(args.root)
    reason = group_reason(args.name)
    for name in recorded:
        record = db.get("packages", {}).get(name)
        if isinstance(record, dict):
            record["reasons"] = sorted(set(record.get("reasons", [])) - {reason})
    db.setdefault("groups", {}).pop(args.name, None)
    save_installed(args.root, db)


def command_group_upgrade(args: argparse.Namespace) -> None:
    db = load_installed(args.root)
    group_record = db.get("groups", {}).get(args.name)
    if not isinstance(group_record, dict):
        raise Ki2CtlError(f"package group is not installed: {args.name}")
    groups = group_catalog_for_command(args)
    with_optional = bool(group_record.get("with_optional", False))
    resolved_groups, roots, services, disabled_services = resolve_package_group(
        groups, args.name, with_optional=with_optional
    )
    plan = install_plan(args, roots)
    package_names = [str(pkg.get("name", "")) for _repo, pkg in plan]
    for _repo, pkg in plan:
        print(f"{pkg['name']} {package_version_label(pkg)} [{group_reason(args.name)}]")
    if args.dry_run:
        return
    execute_install_plan(
        args,
        plan,
        reasons_by_package={name: [group_reason(args.name)] for name in package_names},
    )
    record_group_install(
        args.root,
        args.name,
        resolved_groups,
        package_names,
        services,
        disabled_services,
        with_optional=with_optional,
    )


def command_install(args: argparse.Namespace) -> None:
    plan = install_plan(args, args.names)
    for _repo, pkg in plan:
        print(f"{pkg['name']} {package_version_label(pkg)}")
    if args.dry_run:
        return
    execute_install_plan(args, plan, reasons_by_package=explicit_install_reasons(args, args.names))


def command_installed_list(args: argparse.Namespace) -> None:
    db = load_installed(args.root)
    packages = db.get("packages", {})
    if not packages:
        print("no installed packages recorded")
        return
    for name in sorted(packages):
        pkg = packages[name]
        reasons = ",".join(pkg.get("reasons", [])) or "unknown"
        print(f"{name}\t{pkg.get('version')}-{pkg.get('release')}\t{reasons}")


def command_remove(args: argparse.Namespace) -> None:
    db = load_installed(args.root)
    packages = db.get("packages", {})
    removing = set(args.names)
    for name in args.names:
        if name not in packages:
            raise Ki2CtlError(f"package is not installed: {name}")
    blocks = reverse_dependency_blocks(packages, removing)
    if blocks and not args.force:
        raise Ki2CtlError("reverse dependencies prevent removal:\n" + "\n".join(f"  {item}" for item in blocks))
    if args.dry_run:
        for name in args.names:
            for item in sorted(packages[name].get("files", []), reverse=True):
                print(f"remove {item}")
        return

    db_before = copy.deepcopy(db)
    records = [copy.deepcopy(packages[name]) for name in args.names]
    owner_sets = file_owner_sets(db_before)
    tx_plan = [(Repo(name="installed", url="installed"), record, Path()) for record in records]
    tx = begin_transaction(args.root, args.command, tx_plan)
    try:
        prepare_remove_backups(args.root, tx, records)
        for name in args.names:
            files = sorted(packages[name].get("files", []), reverse=True)
            for item in files:
                if str(item) == GENERATED_INFO_INDEX:
                    continue
                print(f"remove {item}")
                other_owners = owner_sets.get(str(item), set()) - removing
                if other_owners:
                    print(f"preserve {item} (shared by {', '.join(sorted(other_owners))})")
                    continue
                target = safe_target(args.root, item.lstrip("/"))
                if target.is_dir() and not target.is_symlink():
                    with contextlib.suppress(OSError):
                        target.rmdir()
                else:
                    with contextlib.suppress(FileNotFoundError):
                        target.unlink()
                    prune_empty_parent_dirs(args.root, target.parent)
            record_pending_hooks(args.root, name, files, phase="post-remove")
            del packages[name]
            tx.setdefault("events", []).append({"event": "removed", "package": name, "files": len(files)})
            update_transaction(args.root, tx)
        removed_dependency_reasons = {f"dependency:{name}" for name in args.names}
        for record in packages.values():
            if isinstance(record, dict):
                record["reasons"] = sorted(set(record.get("reasons", [])) - removed_dependency_reasons)
        for group_record in db.get("groups", {}).values():
            if not isinstance(group_record, dict):
                continue
            group_packages = [name for name in group_record.get("packages", []) if name not in removing]
            if len(group_packages) != len(group_record.get("packages", [])):
                group_record["packages"] = group_packages
                group_record["status"] = "partial"
        save_installed(args.root, db)
    except Exception as exc:
        tx.setdefault("events", []).append({"event": "error", "message": str(exc)})
        update_transaction(args.root, tx)
        rollback_transaction(args.root, tx, db_before)
        raise
    finish_transaction(args.root, tx, "succeeded")


def command_upgrade(args: argparse.Namespace) -> None:
    installed = load_installed(args.root).get("packages", {})
    if not installed:
        print("no installed packages recorded")
        return
    catalog = package_catalog(indexes_for_command(args))
    candidates = args.names or sorted(installed)
    roots: list[str] = []
    for name in candidates:
        if name not in installed:
            raise Ki2CtlError(f"package is not installed: {name}")
        if name not in catalog:
            raise Ki2CtlError(f"package not found in repositories: {name}")
        _repo, latest = catalog[name]
        current = installed[name]
        if package_sort_key(latest) > installed_sort_key(current):
            roots.append(name)
    if not roots:
        print("no upgrades available")
        return
    plan = install_plan(args, roots)
    for _repo, pkg in plan:
        current = installed.get(str(pkg.get("name", "")))
        current_label = package_version_label(current) if isinstance(current, dict) else "-"
        print(f"{pkg['name']} {current_label} -> {package_version_label(pkg)}")
    if args.dry_run:
        return
    execute_install_plan(args, plan)


def command_hooks_list(args: argparse.Namespace) -> None:
    hooks = load_pending_hooks(args.root).get("hooks", [])
    if not hooks:
        print("no pending hooks")
        return
    for item in hooks:
        if not isinstance(item, dict):
            continue
        print(f"{item.get('status', 'pending')}\t{item.get('phase', 'post-install')}\t{item.get('action')}\t{item.get('package')}")


def rebuild_info_index(root: Path) -> None:
    directory = root / "usr/share/info"
    if not directory.exists():
        return
    if directory.is_symlink() or not directory.resolve().is_relative_to(root.resolve()):
        raise Ki2CtlError("Info directory must stay inside target root")
    output = directory / "dir"
    if output.is_symlink():
        raise Ki2CtlError("Info index must not be a symlink")
    manuals = sorted(p for p in directory.iterdir()
                     if p.name.endswith((".info", ".info.gz", ".info.xz", ".info.bz2")))
    if any(p.is_symlink() or not p.is_file() for p in manuals):
        raise Ki2CtlError("Info manuals must be regular files")
    tool = shutil.which("install-info")
    if tool is None:
        raise Ki2CtlError("missing command for info-index-rebuild: install-info")
    environment = os.environ.copy()
    for key in ("LD_LIBRARY_PATH", "LD_PRELOAD"):
        environment.pop(key, None)
    environment["LC_ALL"] = "C"
    try:
        with tempfile.TemporaryDirectory(prefix=".ki2-info-", dir=directory) as temporary:
            index = Path(temporary) / "dir"
            index.write_text("\x1f\nFile: dir, Node: Top\n\n* Menu:\n", encoding="utf-8")
            for manual in manuals:
                subprocess.run([tool, "--dir-file=" + str(index), str(manual)],
                               env=environment, check=True, capture_output=True, text=True, timeout=30)
            index.chmod(0o644)
            index.replace(output)
    except (OSError, subprocess.SubprocessError) as exc:
        raise Ki2CtlError(f"Info index rebuild failed: {exc}") from exc


def run_hook_action(action: str, root: Path, dry_run: bool) -> bool:
    if dry_run:
        print(f"would run {action}")
        return False
    if root != Path("/"):
        print(f"deferred {action}: apply inside the installed system or run with --root /")
        return False
    if action == "info-index-rebuild":
        rebuild_info_index(root)
        print(f"ran {action}")
        return True
    commands = {
        "glib-compile-schemas": ["glib-compile-schemas", "--strict", "/usr/share/glib-2.0/schemas"],
        "ldconfig": ["ldconfig"],
        "systemd-daemon-reload": ["systemctl", "daemon-reload"],
        "systemd-tmpfiles-create": ["systemd-tmpfiles", "--create"],
    }
    command = commands.get(action)
    if not command:
        raise Ki2CtlError(f"unknown hook action: {action}")
    if shutil.which(command[0]) is None:
        raise Ki2CtlError(f"missing command for {action}: {command[0]}")
    try:
        subprocess.run(command, check=True)
    except (OSError, subprocess.CalledProcessError) as exc:
        raise Ki2CtlError(f"hook failed: {action}: {exc}") from exc
    print(f"ran {action}")
    return True


def command_hooks_apply(args: argparse.Namespace) -> None:
    data = load_pending_hooks(args.root)
    hooks = [item for item in data.get("hooks", []) if isinstance(item, dict)]
    if not hooks:
        print("no pending hooks")
        return
    for item in hooks:
        if item.get("status") == "applied":
            continue
        action = str(item.get("action", ""))
        try:
            applied = run_hook_action(action, args.root, args.dry_run)
        except Ki2CtlError as exc:
            item["status"] = "failed"
            item["last_error"] = str(exc)
            save_pending_hooks(args.root, data)
            raise
        if applied:
            item["status"] = "applied"
            item.pop("last_error", None)
            item["applied_at"] = dt.datetime.now(UTC).isoformat()
    if not args.dry_run:
        save_pending_hooks(args.root, data)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="KIKI HTTP package manager")
    parser.add_argument("--root", type=Path, default=Path("/"), help="target root, defaults to /")
    parser.add_argument("--arch", default=DEFAULT_ARCH)
    parser.add_argument("--repo", default="", help="temporary repository base URL or local path")
    parser.add_argument("--group-file", type=Path, default=None, help="override the installed package group catalog")
    parser.add_argument("--version", action="version", version=f"ki2ctl {APP_VERSION}")
    subcommands = parser.add_subparsers(dest="command", required=True)

    repo = subcommands.add_parser("repo", help="manage repositories")
    repo_sub = repo.add_subparsers(dest="repo_command", required=True)
    repo_set = repo_sub.add_parser("set", help="set a repository URL or local path")
    repo_set.add_argument("url")
    repo_set.add_argument("--name", default=DEFAULT_REPO_NAME)
    repo_set.add_argument("--verify-key", default="", help="store repository Ed25519 public key or legacy HMAC key path")
    repo_set.set_defaults(func=command_repo_set)
    repo_remove = repo_sub.add_parser("remove", help="remove a repository config and cached index")
    repo_remove.add_argument("name", nargs="?", default=DEFAULT_REPO_NAME)
    repo_remove.set_defaults(func=command_repo_remove)
    repo_list = repo_sub.add_parser("list", help="list configured repositories")
    repo_list.set_defaults(func=command_repo_list)

    update = subcommands.add_parser("update", help="download repository indexes")
    update.add_argument("--verify-key", type=Path, default=None, help="verify repository metadata with an Ed25519 public key or legacy HMAC key")
    update.add_argument("--require-signature", action="store_true", help="fail when no repository verify key is configured")
    update.add_argument("--no-verify", action="store_true", help="skip configured repository metadata verification")
    update.set_defaults(func=command_update)

    search = subcommands.add_parser("search", help="search packages")
    search.add_argument("term")
    search.set_defaults(func=command_search)

    info = subcommands.add_parser("info", help="show package metadata")
    info.add_argument("name")
    info.set_defaults(func=command_info)

    group = subcommands.add_parser("group", help="manage declarative package groups")
    group_sub = group.add_subparsers(dest="group_command", required=True)
    group_list = group_sub.add_parser("list", help="list available and installed groups")
    group_list.set_defaults(func=command_group_list)
    group_info = group_sub.add_parser("info", help="show group packages and services")
    group_info.add_argument("name")
    group_info.set_defaults(func=command_group_info)
    group_install = group_sub.add_parser("install", help="install a package group")
    group_install.add_argument("name")
    group_install.add_argument("--with-optional", action="store_true")
    group_install.add_argument("--dry-run", action="store_true")
    group_install.add_argument("--reinstall", action="store_true")
    group_install.set_defaults(func=command_group_install)
    group_remove = group_sub.add_parser("remove", help="remove packages owned only by a group")
    group_remove.add_argument("name")
    group_remove.add_argument("--dry-run", action="store_true")
    group_remove.add_argument("--keep-packages", action="store_true", help="remove group ownership but retain packages")
    group_remove.set_defaults(func=command_group_remove)
    group_upgrade = group_sub.add_parser("upgrade", help="install missing packages and upgrade an installed group")
    group_upgrade.add_argument("name")
    group_upgrade.add_argument("--dry-run", action="store_true")
    group_upgrade.add_argument("--reinstall", action="store_true")
    group_upgrade.set_defaults(func=command_group_upgrade)

    install = subcommands.add_parser("install", help="install packages and runtime dependencies")
    install.add_argument("names", nargs="+")
    install.add_argument("--dry-run", action="store_true")
    install.add_argument("--reinstall", action="store_true")
    install.set_defaults(func=command_install)

    upgrade = subcommands.add_parser("upgrade", help="upgrade installed packages from configured repositories")
    upgrade.add_argument("names", nargs="*")
    upgrade.add_argument("--dry-run", action="store_true")
    upgrade.add_argument("--reinstall", action="store_true")
    upgrade.set_defaults(func=command_upgrade)

    installed = subcommands.add_parser("list", help="list installed package records")
    installed.set_defaults(func=command_installed_list)

    remove = subcommands.add_parser("remove", help="remove installed package records and files")
    remove.add_argument("names", nargs="+")
    remove.add_argument("--dry-run", action="store_true")
    remove.add_argument("--force", action="store_true", help="remove even when installed packages depend on the target")
    remove.set_defaults(func=command_remove)

    hooks = subcommands.add_parser("hooks", help="list or apply pending post-install hooks")
    hooks_sub = hooks.add_subparsers(dest="hooks_command", required=True)
    hooks_list = hooks_sub.add_parser("list", help="list pending hooks")
    hooks_list.set_defaults(func=command_hooks_list)
    hooks_apply = hooks_sub.add_parser("apply", help="apply pending hooks")
    hooks_apply.add_argument("--dry-run", action="store_true")
    hooks_apply.set_defaults(func=command_hooks_apply)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    args.root = args.root.resolve()
    if isinstance(getattr(args, "group_file", None), Path):
        args.group_file = args.group_file.resolve()
    if isinstance(getattr(args, "verify_key", None), Path):
        args.verify_key = args.verify_key.resolve()
    try:
        args.func(args)
    except (Ki2CtlError, OSError, json.JSONDecodeError, tarfile.TarError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
