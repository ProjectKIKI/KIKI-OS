MAIL_DIR        /var/mail
FAILLOG_ENAB    yes
LOG_UNKFAIL_ENAB no
LOG_OK_LOGINS   no
SYSLOG_SU_ENAB  yes
SYSLOG_SG_ENAB  yes

PASS_MAX_DAYS   99999
PASS_MIN_DAYS   0
PASS_WARN_AGE   7
ENCRYPT_METHOD  YESCRYPT

UID_MIN         1000
UID_MAX         60000
SYS_UID_MIN     101
SYS_UID_MAX     999
GID_MIN         1000
GID_MAX         60000
SYS_GID_MIN     101
SYS_GID_MAX     999

LOGIN_RETRIES   3
LOGIN_TIMEOUT   60
CHFN_RESTRICT   rwh
DEFAULT_HOME    yes
USERGROUPS_ENAB yes
UMASK           022
