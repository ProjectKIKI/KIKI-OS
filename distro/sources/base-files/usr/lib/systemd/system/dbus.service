[Unit]
Description=D-Bus System Message Bus
Documentation=man:dbus-daemon(1)
DefaultDependencies=no
Requires=dbus.socket
After=sysinit.target local-fs.target dbus.socket
Before=basic.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
# dbus-daemon drops privileges to messagebus from system.conf after setup.
ExecStart=/usr/bin/dbus-daemon --system --address=systemd: --nofork --nopidfile --systemd-activation
ExecReload=/usr/bin/dbus-send --print-reply --system --type=method_call --dest=org.freedesktop.DBus / org.freedesktop.DBus.ReloadConfig
Restart=on-failure

[Install]
WantedBy=basic.target
Also=dbus.socket
