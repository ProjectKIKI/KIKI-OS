#!/usr/bin/env python3
import json
import os
import socket
import sys
import time
from pathlib import Path
from urllib import error, request
from urllib.parse import urljoin


CONFIG = Path("/etc/kiki/node.json")


def load_config():
    if not CONFIG.exists():
        return {
            "node": socket.gethostname(),
            "management_url": os.environ.get("KIKI_MANAGEMENT_URL", ""),
            "heartbeat_interval": int(os.environ.get("KIKI_HEARTBEAT_INTERVAL", "60")),
        }
    return json.loads(CONFIG.read_text(encoding="utf-8"))


def post(url, payload):
    body = json.dumps(payload).encode("utf-8")
    req = request.Request(
        url,
        data=body,
        headers={"Content-Type": "application/json", "User-Agent": "kiki-agent/0.1"},
        method="POST",
    )
    with request.urlopen(req, timeout=10) as response:
        response.read()


def main():
    config = load_config()
    base = config.get("management_url", "").rstrip("/") + "/"
    if base == "/":
        print("kiki-agent: no management_url configured", file=sys.stderr)
        return 0

    node = config.get("node") or socket.gethostname()
    payload = {
        "apiVersion": "kiki.io/v1alpha1",
        "kind": "KikiNodeRegistration",
        "metadata": {"name": node},
        "spec": {
            "phase": "booted",
            "hostname": socket.gethostname(),
            "role": config.get("role", "standalone"),
        },
    }
    post(urljoin(base, config.get("callback_path", "/api/v1/nodes/register").lstrip("/")), payload)

    interval = int(config.get("heartbeat_interval", 60))
    heartbeat = {
        "apiVersion": "kiki.io/v1alpha1",
        "kind": "KikiNodeHeartbeat",
        "metadata": {"name": node},
        "spec": {"role": config.get("role", "standalone")},
    }
    while interval > 0:
        try:
            post(urljoin(base, config.get("heartbeat_path", "/api/v1/nodes/heartbeat").lstrip("/")), heartbeat)
        except (error.URLError, TimeoutError) as exc:
            print(f"kiki-agent: heartbeat failed: {exc}", file=sys.stderr)
        time.sleep(interval)


if __name__ == "__main__":
    main()
