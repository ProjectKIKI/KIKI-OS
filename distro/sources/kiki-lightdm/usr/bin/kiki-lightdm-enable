#!/bin/sh
set -eu
if [ "$(id -u)" -ne 0 ]; then
    echo "Run as root." >&2
    exit 1
fi
for file in /usr/sbin/lightdm /usr/sbin/lightdm-gtk-greeter /usr/bin/Xorg /usr/bin/xterm /usr/lib/security/pam_unix.so; do
    if [ ! -e "$file" ]; then
        echo "Missing LightDM dependency: $file" >&2
        exit 1
    fi
done
if ! command -v systemd-sysusers >/dev/null 2>&1; then
    echo "systemd-sysusers is required." >&2
    exit 1
fi
systemd-sysusers /usr/lib/sysusers.d/kiki-lightdm.conf
if command -v systemd-tmpfiles >/dev/null 2>&1; then
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/lightdm.conf /usr/lib/tmpfiles.d/kiki-lightdm.conf
fi
if command -v glib-compile-schemas >/dev/null 2>&1; then
    glib-compile-schemas /usr/share/glib-2.0/schemas
fi
systemctl daemon-reload
if [ -e /etc/systemd/system/display-manager.service ] || [ -L /etc/systemd/system/display-manager.service ]; then
    current=$(readlink /etc/systemd/system/display-manager.service || true)
    case "$current" in
        */lightdm.service|lightdm.service) ;;
        *) echo "Another display manager is already enabled: $current" >&2; exit 1 ;;
    esac
fi
systemctl enable lightdm.service
echo "LightDM is enabled. Use 'systemctl set-default graphical.target' to show it at boot."
