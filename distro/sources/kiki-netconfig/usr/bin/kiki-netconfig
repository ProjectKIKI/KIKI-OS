#!/usr/bin/env python3
"""Small systemd-networkd configuration tool for KIKI OS."""

from __future__ import annotations

import argparse
import ipaddress
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path


DEFAULT_MATCH = "en* eth*"
DEFAULT_NETWORK_FILE = "20-kiki.network"
NETWORK_DIR = "etc/systemd/network"
RESOLVED_DROPIN_DIR = "etc/systemd/resolved.conf.d"


def die(message: str) -> int:
    print(f"kiki-netconfig: {message}", file=sys.stderr)
    return 2


def root_path(root: Path, relative: str) -> Path:
    return root / relative.strip("/")


def normalize_values(values: list[str] | None) -> list[str]:
    result: list[str] = []
    for value in values or []:
        for item in value.replace(",", " ").split():
            item = item.strip()
            if item:
                result.append(item)
    return result


def validate_match_name(value: str) -> str:
    text = value.strip()
    if not text:
        raise ValueError("interface match must not be empty")
    if any(ord(ch) < 32 for ch in text) or "/" in text or "=" in text:
        raise ValueError("interface match must not contain controls, slash or equals")
    return text


def validate_ip_interface(value: str) -> str:
    ipaddress.ip_interface(value)
    return value


def validate_ip_address(value: str, field: str) -> str:
    try:
        ipaddress.ip_address(value)
    except ValueError as exc:
        raise ValueError(f"{field} must be an IP address: {value}") from exc
    return value


def validate_hostname_or_ip(value: str, field: str) -> str:
    if not value or any(ch.isspace() for ch in value) or "/" in value:
        raise ValueError(f"{field} value is not valid: {value}")
    if value.replace(".", "").replace("-", "").replace("_", "").replace(":", "").isalnum():
        return value
    raise ValueError(f"{field} value is not valid: {value}")


def render_networkd(
    *,
    mode: str,
    match_name: str,
    address: str = "",
    gateway: str = "",
    dns: list[str] | None = None,
    ntp: list[str] | None = None,
    ipv6_ra: bool = False,
) -> str:
    lines = [
        "# Generated by kiki-netconfig. Edit with care.",
        "[Match]",
        f"Name={match_name}",
        "",
        "[Link]",
        "RequiredForOnline=no" if mode == "off" else "RequiredForOnline=routable",
        "",
        "[Network]",
    ]
    if mode == "dhcp":
        lines.extend(["DHCP=ipv4", "IPv6AcceptRA=yes"])
    elif mode == "static":
        lines.extend(["DHCP=no", f"Address={address}"])
        if gateway:
            lines.append(f"Gateway={gateway}")
        for item in dns or []:
            lines.append(f"DNS={item}")
        for item in ntp or []:
            lines.append(f"NTP={item}")
        lines.append(f"IPv6AcceptRA={'yes' if ipv6_ra else 'no'}")
    elif mode == "off":
        lines.extend(["DHCP=no", "LinkLocalAddressing=no", "IPv6AcceptRA=no"])
    else:
        raise ValueError(f"unknown network mode: {mode}")
    return "\n".join(lines) + "\n"


def render_resolved_dropin(dns: list[str]) -> str:
    lines = ["# Generated by kiki-netconfig.", "[Resolve]"]
    if dns:
        lines.append("DNS=" + " ".join(dns))
    return "\n".join(lines) + "\n"


def network_file_path(root: Path, filename: str) -> Path:
    if "/" in filename or "\\" in filename or filename in {"", ".", ".."}:
        raise ValueError("network file name must be a plain file name")
    return root_path(root, NETWORK_DIR) / filename


def write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8", newline="\n") as handle:
        handle.write(text)


def write_config(args: argparse.Namespace, text: str, dns: list[str] | None = None) -> Path:
    target = network_file_path(args.root, args.file)
    write_text(target, text)
    if dns and args.write_resolved_dropin:
        write_text(root_path(args.root, RESOLVED_DROPIN_DIR) / "10-kiki-dns.conf", render_resolved_dropin(dns))
    return target


def systemd_env() -> dict[str, str]:
    env = os.environ.copy()
    env["PATH"] = "/usr/sbin:/usr/bin:/sbin:/bin"
    env.setdefault("SYSTEMD_COLORS", "1")
    env.setdefault("SYSTEMD_URLIFY", "0")
    env.setdefault("SYSTEMD_LESS", "FRSXMK")
    return env


def apply_live_config() -> int:
    commands = [
        ["systemctl", "restart", "systemd-networkd.service"],
        ["systemctl", "restart", "systemd-resolved.service"],
    ]
    for command in commands:
        proc = subprocess.run(command, text=True, env=systemd_env())
        if proc.returncode != 0:
            return proc.returncode
    return 0


def maybe_apply(args: argparse.Namespace) -> int:
    if not args.apply:
        return 0
    if args.root != Path("/"):
        print(f"deferred: run 'kiki-netconfig --root / apply' inside the installed system")
        return 0
    return apply_live_config()


def command_dhcp(args: argparse.Namespace) -> int:
    try:
        match_name = validate_match_name(args.match)
        text = render_networkd(mode="dhcp", match_name=match_name)
    except ValueError as exc:
        return die(str(exc))
    if args.dry_run:
        print(text, end="")
        return 0
    path = write_config(args, text)
    print(f"wrote DHCP network profile: {path}")
    return maybe_apply(args)


def command_static(args: argparse.Namespace) -> int:
    try:
        match_name = validate_match_name(args.match)
        address = validate_ip_interface(args.address)
        gateway = validate_ip_address(args.gateway, "gateway") if args.gateway else ""
        dns = [validate_ip_address(item, "dns") for item in normalize_values(args.dns)]
        ntp = [validate_hostname_or_ip(item, "ntp") for item in normalize_values(args.ntp)]
        text = render_networkd(
            mode="static",
            match_name=match_name,
            address=address,
            gateway=gateway,
            dns=dns,
            ntp=ntp,
            ipv6_ra=args.ipv6_ra,
        )
    except ValueError as exc:
        return die(str(exc))
    if args.dry_run:
        print(text, end="")
        return 0
    path = write_config(args, text, dns=dns)
    print(f"wrote static network profile: {path}")
    return maybe_apply(args)


def command_off(args: argparse.Namespace) -> int:
    try:
        match_name = validate_match_name(args.match)
        text = render_networkd(mode="off", match_name=match_name)
    except ValueError as exc:
        return die(str(exc))
    if args.dry_run:
        print(text, end="")
        return 0
    path = write_config(args, text)
    print(f"wrote disabled network profile: {path}")
    return maybe_apply(args)


def command_show(args: argparse.Namespace) -> int:
    try:
        path = network_file_path(args.root, args.file)
    except ValueError as exc:
        return die(str(exc))
    print(f"network profile: {path}")
    if path.exists():
        print(path.read_text(encoding="utf-8"), end="")
    else:
        print("not configured")
    return 0


def command_status(args: argparse.Namespace) -> int:
    status = command_show(args)
    if status != 0 or args.root != Path("/"):
        return status
    for command in (["networkctl", "status", "--no-pager"], ["resolvectl", "status", "--no-pager"]):
        print("")
        subprocess.run(command, text=True, env=systemd_env())
    return 0


def command_apply(args: argparse.Namespace) -> int:
    if args.root != Path("/"):
        return die("apply only works with --root /")
    return apply_live_config()


def interfaces() -> list[dict]:
    """Read actual Ethernet devices; no synthetic/demo entries."""
    proc = subprocess.run(["ip", "-j", "-4", "address", "show"],
                          check=True, capture_output=True, text=True, timeout=5, env=systemd_env())
    return [item for item in json.loads(proc.stdout)
            if (Path("/sys/class/net") / item["ifname"] / "device").exists()
            and re.fullmatch(r"[A-Za-z0-9_.:-]{1,15}", item["ifname"])]


def heading(step: str) -> None:
    if sys.stdout.isatty() and os.environ.get("TERM") != "dumb":
        print("\033[2J\033[H\033[1;36m", end="")
    print("  KIKI NETWORK SETUP")
    print("  " + "=" * 64)
    if sys.stdout.isatty():
        print("\033[0m", end="")
    print(f"  {step}\n")


def interface_line(item: dict) -> str:
    addresses = ", ".join(f"{a['local']}/{a['prefixlen']}"
                          for a in item.get("addr_info", []) if a.get("family") == "inet")
    return f"{item['ifname']:<15} {item.get('operstate', 'UNKNOWN'):<10} {addresses or 'No IPv4 address'}"


def command_list(args: argparse.Namespace) -> int:
    for item in interfaces():
        print(interface_line(item))
    return 0


def validate_static_settings(address: str, gateway: str, dns: list[str]) -> None:
    if "/" not in address:
        raise ValueError("address needs a prefix, for example 192.168.1.20/24")
    interface = ipaddress.ip_interface(address)
    if interface.ip.is_unspecified or interface.ip.is_multicast or interface.ip.is_loopback:
        raise ValueError("use a unicast interface address")
    if gateway:
        gw = ipaddress.ip_address(gateway)
        if gw.version != interface.version or gw.is_unspecified or gw.is_multicast or gw.is_loopback:
            raise ValueError("gateway must be a unicast address of the same IP family")
        if gw not in interface.network and not gw.is_link_local:
            raise ValueError("gateway must be on the selected subnet")
    for value in dns:
        server = ipaddress.ip_address(value)
        if server.is_unspecified or server.is_multicast:
            raise ValueError("DNS must be a unicast address")


def save_tui_profile(root: Path, name: str, text: str) -> tuple[Path, Path | None]:
    if not re.fullmatch(r"[A-Za-z0-9_.:-]{1,15}", name):
        raise ValueError("invalid interface name")
    if root == Path("/") and os.geteuid() != 0:
        raise PermissionError("saving live settings requires sudo")
    target = network_file_path(root, f"10-kiki-{name}.network")
    for parent in [target, *target.parents]:
        if parent == root:
            break
        if parent.is_symlink():
            raise ValueError(f"refusing symbolic link: {parent}")
    backup = None
    if target.exists():
        if not target.is_file() or not target.read_text().startswith("# Generated by kiki-netconfig."):
            raise ValueError(f"not a kiki-netconfig managed file: {target}")
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists():
        backup = target.with_name(target.name + f".bak-{time.time_ns()}")
        with backup.open("xb") as handle:
            handle.write(target.read_bytes())
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", newline="\n",
                                         dir=target.parent, delete=False) as handle:
            temporary = Path(handle.name)
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        temporary.chmod(0o644)
        os.replace(temporary, target)
    finally:
        if temporary is not None and temporary.exists():
            temporary.unlink()
    return target, backup


def command_tui(args: argparse.Namespace) -> int:
    heading("1 / 3   Select interface")
    devices = interfaces()
    if not devices:
        print("  No hardware network interfaces found.")
        return 1
    for number, item in enumerate(devices, 1):
        print(f"  {number}) {interface_line(item)}")
    print("\n  q) Quit without changes\n")
    selection = input("  Interface [q]: ").strip()
    if selection.lower() in {"", "q"}:
        return 0
    if not selection.isdecimal() or not 1 <= int(selection) <= len(devices):
        raise ValueError("choose an interface number from the list")
    name = devices[int(selection) - 1]["ifname"]
    heading(f"2 / 3   Configure {name}")
    print("  1) DHCP (automatic IPv4)\n  2) Static IP\n  q) Cancel\n")
    mode = input("  Mode [1]: ").strip().lower() or "1"
    if mode == "q":
        return 0
    if mode not in {"1", "2"}:
        raise ValueError("choose 1 or 2")
    address = gateway = ""
    dns = []
    if mode == "2":
        address = input("  Address / prefix : ").strip()
        gateway = input("  Gateway (optional): ").strip()
        dns = normalize_values([input("  DNS (comma separated, optional): ")])
        validate_static_settings(address, gateway, dns)
    text = render_networkd(mode="dhcp" if mode == "1" else "static",
                          match_name=name, address=address, gateway=gateway, dns=dns)
    heading("3 / 3   Review settings")
    print(f"  Interface : {name}")
    print(f"  Mode      : {'DHCP / automatic IPv4' if mode == '1' else 'Static IP'}")
    print(f"  Address   : {address or 'Automatic'}")
    print(f"  Gateway   : {gateway or ('Automatic' if mode == '1' else 'None')}")
    print(f"  DNS       : {', '.join(dns) or ('Automatic' if mode == '1' else 'Not set')}")
    print(f"\n  File: /etc/systemd/network/10-kiki-{name}.network")
    print("  Earlier matching profiles may take priority. Other files stay unchanged.")
    print("  Applying may disconnect SSH. No timed automatic rollback.")
    if args.dry_run:
        print("\n  PREVIEW ONLY - no files or network settings will be changed.")
        input("\n  Press Enter to exit: ")
        return 0
    print("\n  s) Save only    a) Save and apply    q) Cancel")
    action = input("\n  Action [q]: ").strip().lower()
    if action in {"", "q"}:
        return 0
    if action not in {"s", "a"}:
        raise ValueError("choose s, a or q")
    if action == "a":
        if args.root != Path("/"):
            raise ValueError("live apply only works with --root /; use Save only")
        if input("  Type APPLY to confirm possible connection loss: ").strip() != "APPLY":
            print("  Cancelled.")
            return 0
    path, backup = save_tui_profile(args.root, name, text)
    print(f"\n  Saved: {path}")
    if backup:
        print(f"  Backup: {backup}")
    if action == "a":
        for command in (["networkctl", "reload"], ["networkctl", "reconfigure", name]):
            result = subprocess.run(command, env=systemd_env(), timeout=30)
            if result.returncode:
                return die(f"apply failed; saved profile remains at {path}; backup: {backup or 'new profile'}")
        print(f"  Apply requested. Verify with: networkctl status {name}")
    return 0


def add_common_write_options(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--match", default=DEFAULT_MATCH, help="systemd-networkd Name= match expression")
    parser.add_argument("--file", default=DEFAULT_NETWORK_FILE, help="networkd file name under /etc/systemd/network")
    parser.add_argument("--dry-run", action="store_true", help="print generated config without writing it")
    parser.add_argument("--apply", action="store_true", help="restart systemd-networkd and systemd-resolved after writing")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Configure KIKI OS systemd-networkd profiles")
    parser.add_argument("--root", type=Path, default=Path("/"), help="target root filesystem")
    subcommands = parser.add_subparsers(dest="command", required=True)

    tui = subcommands.add_parser("tui", help="simple numbered network setup")
    tui.add_argument("--dry-run", action="store_true", help="interactive preview; never save or apply")
    tui.set_defaults(func=command_tui)
    listing = subcommands.add_parser("list", help="list hardware interfaces and IPv4 addresses")
    listing.set_defaults(func=command_list)

    dhcp = subcommands.add_parser("dhcp", help="write a DHCPv4 networkd profile")
    add_common_write_options(dhcp)
    dhcp.set_defaults(func=command_dhcp)

    static = subcommands.add_parser("static", help="write a static IPv4 networkd profile")
    add_common_write_options(static)
    static.add_argument("--address", required=True, help="IPv4 interface address with prefix, for example 192.168.122.50/24")
    static.add_argument("--gateway", default="", help="IPv4 default gateway")
    static.add_argument("--dns", action="append", default=[], help="DNS server, repeat or comma-separate")
    static.add_argument("--ntp", action="append", default=[], help="NTP server, repeat or comma-separate")
    static.add_argument("--ipv6-ra", action="store_true", help="accept IPv6 router advertisements")
    static.add_argument("--write-resolved-dropin", action="store_true", help="also write /etc/systemd/resolved.conf.d/10-kiki-dns.conf")
    static.set_defaults(func=command_static)

    off = subcommands.add_parser("off", help="disable automatic network configuration")
    add_common_write_options(off)
    off.set_defaults(func=command_off)

    show = subcommands.add_parser("show", help="show the configured networkd profile")
    show.add_argument("--file", default=DEFAULT_NETWORK_FILE, help="networkd file name under /etc/systemd/network")
    show.set_defaults(func=command_show)

    status = subcommands.add_parser("status", help="show config and live networkd/resolved status")
    status.add_argument("--file", default=DEFAULT_NETWORK_FILE, help="networkd file name under /etc/systemd/network")
    status.set_defaults(func=command_status)

    apply = subcommands.add_parser("apply", help="restart live systemd network services")
    apply.set_defaults(func=command_apply)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    args.root = args.root.resolve()
    try:
        return args.func(args)
    except (ValueError, OSError, subprocess.SubprocessError) as exc:
        return die(str(exc))
    except (EOFError, KeyboardInterrupt):
        print("\nCancelled.")
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
