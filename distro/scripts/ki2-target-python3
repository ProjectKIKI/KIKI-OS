#!/bin/sh
set -eu

: "${KI2_SYSROOT:?KI2_SYSROOT is required}"
: "${KI2_SYSROOT_LIBRARY_PATH:?KI2_SYSROOT_LIBRARY_PATH is required}"

if [ "${KI2_USE_TARGET_LOADER:-0}" = 1 ]; then
    export PYTHONDONTWRITEBYTECODE=1 PYTHONHASHSEED=0
    # GIR otherwise prepends target libc directories to LD_LIBRARY_PATH before
    # spawning the host compiler. Keep them in the target launcher's variable.
    case "${1:-}" in
        */g-ir-scanner)
            scanner="$1"
            shift
            set -- "$scanner" --lib-dirs-envvar=KI2_SYSROOT_LIBRARY_PATH "$@"
            ;;
    esac
    exec /bin/sh "${KI2_REPO_ROOT}/distro/scripts/ki2-target-run" "${KI2_SYSROOT}/usr/bin/python3.12" "$@"
fi

# Keep host build tools on the host ABI while allowing only the target Python
# process (and extension probes launched by it) to resolve KIKI shared objects.
export LD_LIBRARY_PATH="${KI2_SYSROOT_LIBRARY_PATH}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export PYTHONDONTWRITEBYTECODE=1
export PYTHONHASHSEED=0

exec "${KI2_SYSROOT}/usr/bin/python3.12" "$@"
