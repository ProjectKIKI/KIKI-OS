#!/bin/sh
set -eu

if ! grep -qw 'kiki.autoinstall=1' /proc/cmdline; then
  exit 0
fi
if [ -e /run/kiki-autoinstall-started ]; then
  exit 0
fi
touch /run/kiki-autoinstall-started

exec </dev/console >/dev/console 2>&1
echo KIKI_AUTOINSTALL_START
if kiki-install --yes; then
  sync
  echo KIKI_AUTOINSTALL_COMPLETE
  poweroff -f
fi
echo KIKI_AUTOINSTALL_FAILED
poweroff -f
