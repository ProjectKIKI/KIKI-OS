[Unit]
Description=KIKI version library and candidate ISO worker (rootless)
StartLimitIntervalSec=0

[Service]
Type=simple
Nice=15
Environment=TMPDIR=/build-kikios/kiki-containers/tmp
ExecStartPre=/build-kikios/kiki-build/host-prep-20261023/bin/host-run /usr/bin/true
ExecStart=/usr/bin/podman run --replace --rm --name kiki-release-worker --user 0:0 --network host --memory 1536m --memory-swap 1536m --pids-limit 256 --read-only --tmpfs /tmp:rw,nosuid,nodev,size=256m -v /build-kikios/kiki-build/candidates/mesa-native-20261023/release-code:/app:ro,Z -v /build-kikios/kiki-build/candidates/mesa-native-20261023/repo:/backend:ro,z -v /build-kikios/kiki-build/candidates/mesa-native-20261023/inputs:/inputs:ro,z -v /build-kikios/kiki-build/candidates/mesa-native-20261023/work/sources:/sources:ro,z -v /build-kikios/kiki-build/candidates/mesa-native-20261023/work/packages:/native-packages:ro,z -v /build-kikios/kiki-build/candidates/mesa-native-20261023/release-store:/release-store:Z --entrypoint /opt/kiki-host/venv/bin/python3 localhost/kiki-release-worker:20261023 -I -B /app/ki2release.py serve --store /release-store
ExecStop=/usr/bin/podman stop --time 15 kiki-release-worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
UMask=0077

[Install]
WantedBy=default.target
